#: lib/main_image_builder.py:92
msgid "Help content is unavailable."
msgstr "Il contenuto della guida non è disponibile."

#: lib/main_image_builder.py:107
msgid "Base filesystem and essential system utilities."
msgstr "Filesystem di base e utilità di sistema essenziali."

#: lib/main_image_builder.py:109
msgid "Linux kernel and hardware drivers."
msgstr "Kernel Linux e driver hardware."

#: lib/main_image_builder.py:111
msgid "Firmware for graphics, networking, and other devices."
msgstr "Firmware per grafica, rete e altri dispositivi."

#: lib/main_image_builder.py:113
msgid "Display server and desktop graphics stack."
msgstr "Server grafico e stack grafico desktop."

#: lib/main_image_builder.py:115
msgid "Desktop shell, window manager, and supporting applications."
msgstr "Shell desktop, window manager e applicazioni di supporto."

#: lib/main_image_builder.py:116
msgid "Web browser and its runtime."
msgstr "Browser web e relativo runtime."

#: lib/main_image_builder.py:118
msgid "Additional command-line and system utilities."
msgstr "Ulteriori utilità da riga di comando e di sistema."

#: lib/main_image_builder.py:119
msgid "Bundled user applications."
msgstr "Applicazioni utente incluse."

#: lib/main_image_builder.py:120
msgid "A MiniOS SquashFS module."
msgstr "Un modulo SquashFS MiniOS."

#: lib/main_image_builder.py:125 tests/test_runtime_integration.py:138
msgid "Not enough space for the output image"
msgstr "Spazio insufficiente per l'immagine di output"

#: lib/main_image_builder.py:126
msgid "The selected output location does not have enough free space. Choose an output path on a filesystem with more free space."
msgstr "La posizione di output selezionata non dispone di spazio libero sufficiente. Scegli un percorso di output su un filesystem con più spazio disponibile."

#: lib/main_image_builder.py:129
msgid "Output work files would be saved into the image"
msgstr "I file di lavoro di output verrebbero salvati nell'immagine"

#: lib/main_image_builder.py:130
msgid "The selected output directory is on the live writable layer. This build includes session changes, so private build files created next to the ISO could be captured. Choose an output path on a separate mounted Linux filesystem."
msgstr "La directory di output selezionata si trova sul layer scrivibile live. Questa build include modifiche della sessione, quindi i file di build privati creati accanto all'ISO potrebbero essere acquisiti. Scegli un percorso di output su un filesystem Linux montato separatamente."

#: lib/main_image_builder.py:135
msgid "Output directory is inside the changes being saved"
msgstr "La directory di output è all'interno delle modifiche che stanno per essere salvate"

#: lib/main_image_builder.py:136
msgid "Choose an output path outside the MiniOS changes directory. A separate mounted Linux filesystem is safe."
msgstr "Scegli un percorso di output al di fuori della directory delle modifiche di MiniOS. Un filesystem Linux montato separatamente è sicuro."

#: lib/main_image_builder.py:139 tests/test_runtime_integration.py:140
msgid "Not enough temporary workspace"
msgstr "Spazio temporaneo di lavoro insufficiente"

#: lib/main_image_builder.py:140
msgid "The temporary work directory does not have enough free space. Choose another temporary work directory on the Settings page, or free space on its filesystem."
msgstr "La directory temporanea di lavoro non ha spazio libero sufficiente. Scegli un'altra directory temporanea nella pagina Impostazioni oppure libera spazio sul relativo filesystem."

#: lib/main_image_builder.py:144
msgid "Temporary work directory was not found"
msgstr "La directory di lavoro temporanea non è stata trovata"

#: lib/main_image_builder.py:145
msgid "Choose an existing writable directory on the Settings page."
msgstr "Scegli una directory esistente e scrivibile nella pagina Impostazioni."

#: lib/main_image_builder.py:147
msgid "Temporary work directory is not writable"
msgstr "La directory di lavoro temporanea non è scrivibile"

#: lib/main_image_builder.py:148
msgid "Choose a directory where your user can create and remove files."
msgstr "Scegli una directory in cui il tuo utente possa creare ed eliminare file."

#: lib/main_image_builder.py:150
msgid "Temporary work directory cannot be a symbolic link"
msgstr "La directory di lavoro temporanea non può essere un collegamento simbolico"

#: lib/main_image_builder.py:151
msgid "Choose the real directory instead of a symbolic link."
msgstr "Scegli la directory reale invece di un collegamento simbolico."

#: lib/main_image_builder.py:153
msgid "Storage cannot protect temporary build files"
msgstr "Lo storage non può proteggere i file temporanei di build"

#: lib/main_image_builder.py:154
msgid "Image Builder could not create a private directory with mode 0700 on this storage. Choose a writable Linux filesystem such as ext4."
msgstr "Image Builder non è riuscito a creare una directory privata con modalità 0700 su questo storage. Scegli un filesystem Linux scrivibile come ext4."

#: lib/main_image_builder.py:157
msgid "Temporary work directory became unavailable"
msgstr "La directory di lavoro temporanea è diventata non disponibile"

#: lib/main_image_builder.py:158
msgid "Check that the selected storage is still mounted, then choose the directory again."
msgstr "Verifica che lo storage selezionato sia ancora montato, quindi scegli nuovamente la directory."

#: lib/main_image_builder.py:161
msgid "Temporary work directory path is invalid"
msgstr "Il percorso della directory di lavoro temporanea non è valido"

#: lib/main_image_builder.py:162
msgid "Choose a directory whose path does not contain a line break."
msgstr "Scegli una directory il cui percorso non contenga interruzioni di riga."

#: lib/main_image_builder.py:164
msgid "Temporary work directory is not protected"
msgstr "La directory di lavoro temporanea non è protetta"

#: lib/main_image_builder.py:165
msgid "Another user could replace files in the selected path while the image is being built. Choose a directory owned by you or root that is not shared for writing. Standard /tmp is also supported."
msgstr "Un altro utente potrebbe sostituire i file nel percorso selezionato mentre l'immagine viene creata. Scegli una directory di tua proprietà o di root che non sia condivisa in scrittura. Anche la directory standard /tmp è supportata."

#: lib/main_image_builder.py:169
msgid "Temporary directory is inside the source image"
msgstr "La directory temporanea è all'interno dell'immagine sorgente"

#: lib/main_image_builder.py:170
msgid "Choose a temporary work directory outside the mounted MiniOS source."
msgstr "Scegli una directory di lavoro temporanea al di fuori della sorgente MiniOS montata."

#: lib/main_image_builder.py:173
msgid "Temporary directory is inside the project filesystem layer"
msgstr "La directory temporanea si trova all'interno del layer filesystem del progetto"

#: lib/main_image_builder.py:174
msgid "Choose a temporary work directory outside the directory whose files are being added to the image."
msgstr "Scegli una directory di lavoro temporanea al di fuori della directory i cui file vengono aggiunti all'immagine."

#: lib/main_image_builder.py:177
msgid "Temporary files would be saved into the image"
msgstr "I file temporanei verrebbero salvati nell'immagine"

#: lib/main_image_builder.py:178
msgid "The selected directory is on the live writable layer. This build includes session changes, so its temporary files could be captured. Choose a directory on a separate mounted Linux filesystem."
msgstr "La directory selezionata si trova sul layer scrivibile live. Questa build include le modifiche della sessione, quindi i file temporanei potrebbero essere acquisiti. Scegli una directory su un filesystem Linux separato e montato."

#: lib/main_image_builder.py:182
msgid "Temporary directory is inside the changes being saved"
msgstr "La directory temporanea è all'interno delle modifiche che stanno per essere salvate"

#: lib/main_image_builder.py:183
msgid "Choose a temporary work directory outside the MiniOS changes directory. A separate mounted Linux filesystem is safe."
msgstr "Scegli una directory di lavoro temporanea al di fuori della directory delle modifiche di MiniOS. Un filesystem Linux separato e montato è sicuro."

#: lib/main_image_builder.py:186
msgid "Output and temporary files need more space"
msgstr "Spazio insufficiente per file di output e temporanei"

#: lib/main_image_builder.py:187
msgid "The output image and temporary work directory are on the same filesystem, which does not have enough free space for both at the same time. Move either location to another filesystem or free additional space."
msgstr "L'immagine di output e la directory temporanea di lavoro si trovano sullo stesso filesystem, che non dispone di spazio libero sufficiente per entrambi contemporaneamente. Sposta una delle due posizioni su un altro filesystem oppure libera spazio aggiuntivo."

#: lib/main_image_builder.py:192 tests/test_runtime_integration.py:150
msgid "Configuration may contain sensitive values"
msgstr "La configurazione potrebbe contenere valori sensibili"

#: lib/main_image_builder.py:193
msgid "The current MiniOS configuration contains plaintext settings with sensitive-looking names. Image Builder copies their values unchanged into the new image but does not display or log them. Review the configuration before sharing the image."
msgstr "L'attuale configurazione di MiniOS contiene impostazioni in chiaro con nomi che sembrano sensibili. Image Builder copia questi valori senza modificarli nella nuova immagine, ma non li visualizza né li registra nei log. Controlla la configurazione prima di condividere l'immagine."

#: lib/main_image_builder.py:198 tests/test_runtime_integration.py:152
msgid "Session-change size is unknown"
msgstr "Dimensione della modifica della sessione sconosciuta"

#: lib/main_image_builder.py:199
msgid "No complete analyzed session inventory is available for this estimate. Image Builder does not invent a size; analyze the current session changes on the Settings page if you need a more accurate space estimate."
msgstr "Non è disponibile un inventario completo delle sessioni analizzate per questa stima. Image Builder non inventa una dimensione; analizza le modifiche della sessione corrente nella pagina Impostazioni se hai bisogno di una stima dello spazio più accurata."

#: lib/main_image_builder.py:204 tests/test_runtime_integration.py:117
msgid "Reusable changes only"
msgstr "Solo modifiche riutilizzabili"

#: lib/main_image_builder.py:205 tests/test_runtime_integration.py:119
msgid "Clean capture uses a strict allowlist. It omits general system state, user data, identity files, logs, and caches."
msgstr "La modalità Clean capture utilizza una allowlist rigorosa. Esclude lo stato generale del sistema, i dati utente, i file di identità, i log e le cache."

#: lib/main_image_builder.py:208 tests/test_runtime_integration.py:127
msgid "Source already contains saved session changes"
msgstr "La sorgente contiene già modifiche di sessione salvate"

#: lib/main_image_builder.py:209
msgid "The existing session layer is treated as part of the source, so you can continue modifying the image. To omit that saved session, disable the corresponding *-session-changes.sb module in the module list. If you include changes from the current session, a new layer is added after the existing source modules."
msgstr "Il layer di sessione esistente viene considerato parte della sorgente, quindi puoi continuare a modificare l’immagine. Per escludere quella sessione salvata, disabilita il modulo *-session-changes.sb corrispondente nell’elenco dei moduli. Se includi le modifiche della sessione corrente, verrà aggiunto un nuovo layer dopo i moduli sorgente esistenti."

#: lib/main_image_builder.py:215
msgid "An added module uses a reserved session-layer name"
msgstr "Un modulo aggiunto utilizza un nome riservato per il session-layer"

#: lib/main_image_builder.py:216
msgid "Image Builder reserves *-session-changes.sb for session layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder riserva *-session-changes.sb per i layer di sessione che crea automaticamente. Rinomina o rimuovi il modulo aggiunto prima della generazione."

#: lib/main_image_builder.py:219
msgid "Source was previously customized by Image Builder"
msgstr "La sorgente è stata precedentemente personalizzata da Image Builder"

#: lib/main_image_builder.py:220
msgid "Existing customization data is treated as part of the source. You can continue and apply more changes; newly generated customization metadata replaces the previous report when required."
msgstr "I dati di personalizzazione esistenti vengono considerati parte della sorgente. Puoi continuare e applicare ulteriori modifiche; i nuovi metadati di personalizzazione generati sostituiranno il report precedente quando necessario."

#: lib/main_image_builder.py:224
msgid "An added module uses a reserved customization-layer name"
msgstr "Un modulo aggiunto utilizza un nome riservato per il customization-layer"

#: lib/main_image_builder.py:225
msgid "Image Builder reserves *-image-overlay.sb for project filesystem layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder riserva *-image-overlay.sb per i layer del filesystem di progetto che crea automaticamente. Rinomina o rimuovi il modulo aggiunto prima della generazione."

#: lib/main_image_builder.py:246 tests/test_runtime_integration.py:199
#, python-brace-format
msgid "The image backend reported: {error}"
msgstr "Il backend delle immagini ha segnalato: {error}"

#: lib/main_image_builder.py:248 tests/test_runtime_integration.py:201
#, python-brace-format
msgid "The image command exited with status {status}."
msgstr "Il comando image è terminato con stato {status}."

