msgstr "Восстановить исходное меню"

#: lib/main_image_builder.py:2601
msgid "Kernel parameter reference"
msgstr "Справочник параметров ядра"

#: lib/main_image_builder.py:2603
msgid "Parameter help"
msgstr "Справка по параметрам"

#: lib/main_image_builder.py:2604
msgid "Explain common boot and kernel parameters"
msgstr "Объяснение распространённых параметров загрузки и ядра"

#: lib/main_image_builder.py:2644
