#: lib/main_image_builder.py:93
msgid "Help content is unavailable."
msgstr "Справочный контент недоступен."

#: lib/main_image_builder.py:108
msgid "Base filesystem and essential system utilities."
msgstr "Базовая файловая система и основные системные утилиты."

#: lib/main_image_builder.py:110
msgid "Linux kernel and hardware drivers."
msgstr "Ядро Linux и драйверы оборудования."

#: lib/main_image_builder.py:112
msgid "Firmware for graphics, networking, and other devices."
msgstr "Прошивки для графики, сетевых и других устройств."

#: lib/main_image_builder.py:114
msgid "Display server and desktop graphics stack."
msgstr "Сервер отображения и графический стек рабочего стола."

#: lib/main_image_builder.py:116
msgid "Desktop shell, window manager, and supporting applications."
msgstr "Оболочка рабочего стола, менеджер окон и вспомогательные приложения."

#: lib/main_image_builder.py:117
msgid "Web browser and its runtime."
msgstr "Веб-браузер и его среда выполнения."

#: lib/main_image_builder.py:119
msgid "Additional command-line and system utilities."
msgstr "Дополнительные консольные и системные утилиты."

#: lib/main_image_builder.py:120
msgid "Bundled user applications."
msgstr "Встроенные пользовательские приложения."

#: lib/main_image_builder.py:121
msgid "A MiniOS SquashFS module."
msgstr "Модуль MiniOS в формате SquashFS."

#: lib/main_image_builder.py:126 tests/test_runtime_integration.py:213
msgid "Not enough space for the output image"
msgstr "Недостаточно места для выходного образа"

#: lib/main_image_builder.py:127
msgid "The selected output location does not have enough free space. Choose an output path on a filesystem with more free space."
msgstr "В выбранном месте для сохранения выходного файла недостаточно свободного места. Выберите путь на файловой системе с большим объёмом свободного пространства."

#: lib/main_image_builder.py:130
msgid "Output directory changed or became unavailable"
msgstr "Выходной каталог был изменён или стал недоступен"

#: lib/main_image_builder.py:131
msgid "The selected output directory could not be retained safely. Return to Settings and choose the output location again."
msgstr "Выбранный выходной каталог не удалось безопасно сохранить. Вернитесь в настройки и выберите место сохранения снова."

#: lib/main_image_builder.py:134
msgid "Existing output would be included before replacement"
msgstr "Существующий вывод будет включён перед заменой"

#: lib/main_image_builder.py:135
msgid "The selected output file already exists on the live writable layer. It could be included in the session changes before Image Builder replaces it. Choose a new filename, or move or remove the existing file first. A new image may be saved in this location."
msgstr "Выбранный выходной файл уже существует на активном доступном для записи слое. Его можно включить в изменения сессии до того, как Image Builder его заменит. Выберите новое имя файла или переместите либо удалите существующий файл. Новый образ может быть сохранён в этом месте."

#: lib/main_image_builder.py:140 tests/test_runtime_integration.py:215
msgid "Not enough temporary workspace"
msgstr "Недостаточно места для временной рабочей области"

#: lib/main_image_builder.py:141
msgid "The temporary work directory does not have enough free space. Choose another temporary work directory on the Settings page, or free space on its filesystem."
msgstr "Во временном рабочем каталоге недостаточно свободного места. Выберите другой временный каталог на странице настроек или освободите место на его файловой системе."

#: lib/main_image_builder.py:145
msgid "Temporary work directory was not found"
msgstr "Временный рабочий каталог не найден"

#: lib/main_image_builder.py:146
msgid "Choose an existing writable directory on the Settings page."
msgstr "Выберите существующий доступный для записи каталог на странице настроек."

#: lib/main_image_builder.py:148
msgid "Temporary work directory is not writable"
msgstr "Временный рабочий каталог недоступен для записи"

#: lib/main_image_builder.py:149
msgid "Choose a directory where your user can create and remove files."
msgstr "Выберите каталог, в котором ваш пользователь может создавать и удалять файлы."

#: lib/main_image_builder.py:151
msgid "Temporary work directory cannot be a symbolic link"
msgstr "Временный рабочий каталог не может быть символической ссылкой"

#: lib/main_image_builder.py:152
msgid "Choose the real directory instead of a symbolic link."
msgstr "Выберите реальный каталог вместо символической ссылки."

#: lib/main_image_builder.py:154
msgid "Storage cannot protect temporary build files"
msgstr "Хранилище не может защитить временные файлы сборки"

#: lib/main_image_builder.py:155
msgid "Image Builder could not create a private directory with mode 0700 on this storage. Choose a filesystem with Unix permissions, such as ext4, XFS, or Btrfs."
msgstr "Image Builder не удалось создать приватный каталог с правами 0700 на этом хранилище. Выберите файловую систему с поддержкой Unix-разрешений, например ext4, XFS или Btrfs."

#: lib/main_image_builder.py:159
msgid "Temporary work directory became unavailable"
msgstr "Временный рабочий каталог стал недоступен"

#: lib/main_image_builder.py:160
msgid "Check that the selected storage is still mounted, then choose the directory again."
msgstr "Проверьте, что выбранное хранилище всё ещё подключено, затем выберите каталог заново."

#: lib/main_image_builder.py:163
msgid "Temporary work directory path is invalid"
msgstr "Недопустимый путь к временной рабочей директории"

#: lib/main_image_builder.py:164
msgid "Choose a directory whose path does not contain a line break."
msgstr "Выберите директорию, путь к которой не содержит символов перевода строки."

#: lib/main_image_builder.py:166
msgid "Temporary work directory is not protected"
msgstr "Временная рабочая директория не защищена"

#: lib/main_image_builder.py:167
msgid "Another user could replace files in the selected path while the image is being built. Choose a directory owned by you or root that is not shared for writing. Standard /tmp is also supported."
msgstr "Другой пользователь может заменить файлы по выбранному пути во время сборки образа. Выберите директорию, принадлежащую вам или root и не открытую для записи другими. Также поддерживается стандартный /tmp."

#: lib/main_image_builder.py:171
msgid "Temporary directory is inside the source image"
msgstr "Временный каталог находится внутри исходного образа"

#: lib/main_image_builder.py:172
msgid "Choose a temporary work directory outside the mounted MiniOS source."
msgstr "Выберите временный рабочий каталог вне подключённого исходника MiniOS."

#: lib/main_image_builder.py:175
msgid "Temporary directory is inside the project filesystem layer"
msgstr "Временная директория находится внутри файловой системы проекта"

#: lib/main_image_builder.py:176
msgid "Choose a temporary work directory outside the directory whose files are being added to the image."
msgstr "Выберите временную рабочую директорию вне директории, из которой добавляются файлы в образ."

#: lib/main_image_builder.py:179
msgid "Temporary files would be saved into the image"
msgstr "Временные файлы будут сохранены в образ"

#: lib/main_image_builder.py:180
msgid "The selected directory is on the live writable layer. This build includes session changes, so its temporary files could be captured. Use /tmp when it is tmpfs, or choose disk-backed storage with Unix permissions such as ext4, XFS, or Btrfs."
msgstr "Выбранный каталог находится на активном доступном для записи слое. Эта сборка включает изменения сессии, поэтому временные файлы могут быть захвачены. Используйте /tmp, если это tmpfs, или выберите хранилище на диске с поддержкой Unix-разрешений, например ext4, XFS или Btrfs."

#: lib/main_image_builder.py:185
msgid "Temporary directory is inside the changes being saved"
msgstr "Временный каталог находится внутри сохраняемых изменений"

#: lib/main_image_builder.py:186
msgid "Choose a temporary work directory outside the MiniOS changes directory, for example /tmp when it is tmpfs or disk-backed ext4, XFS, or Btrfs storage."
msgstr "Выберите временный рабочий каталог вне каталога изменений MiniOS, например /tmp, если это tmpfs, или хранилище на диске с ext4, XFS или Btrfs."

#: lib/main_image_builder.py:190
msgid "Output and temporary files need more space"
msgstr "Для выходных и временных файлов требуется больше места"

#: lib/main_image_builder.py:191
msgid "The output image and temporary work directory are on the same filesystem, which does not have enough free space for both at the same time. Move either location to another filesystem or free additional space."
msgstr "Выходной образ и временный рабочий каталог находятся на одной файловой системе, на которой недостаточно свободного места для обоих одновременно. Переместите одну из локаций на другую файловую систему или освободите дополнительное место."

#: lib/main_image_builder.py:196 tests/test_runtime_integration.py:225
msgid "Configuration may contain sensitive values"
msgstr "Конфигурация может содержать конфиденциальные значения"

#: lib/main_image_builder.py:197
msgid "The current MiniOS configuration contains plaintext settings with sensitive-looking names. Image Builder copies their values unchanged into the new image but does not display or log them. Review the configuration before sharing the image."
msgstr "Текущая конфигурация MiniOS содержит настройки в открытом виде с подозрительно конфиденциальными именами. Image Builder копирует их значения без изменений в новый образ, но не отображает и не записывает их в журнал. Проверьте конфигурацию перед тем, как делиться образом."

#: lib/main_image_builder.py:202 tests/test_runtime_integration.py:227
msgid "Session-change size is unknown"
msgstr "Размер изменений сессии неизвестен"

#: lib/main_image_builder.py:203
msgid "No complete analyzed session inventory is available for this estimate. Image Builder does not invent a size; analyze the current session changes on the Settings page if you need a more accurate space estimate."
msgstr "Для этой оценки нет полного проанализированного инвентаря сессии. Image Builder не придумывает размер; проанализируйте текущие изменения сессии на странице настроек, если вам нужна более точная оценка необходимого места."

#: lib/main_image_builder.py:208 tests/test_runtime_integration.py:192
msgid "Reusable changes only"
msgstr "Только повторно используемые изменения"

#: lib/main_image_builder.py:209 tests/test_runtime_integration.py:194
msgid "Clean capture uses a strict allowlist. It omits general system state, user data, identity files, logs, and caches."
msgstr "При захвате только повторно используемых изменений применяется строгий список разрешённых путей. Общее состояние системы, данные пользователей, файлы идентификации, журналы и кэш не включаются."

#: lib/main_image_builder.py:212 tests/test_runtime_integration.py:202
msgid "Source already contains saved session changes"
msgstr "Источник уже содержит сохранённые изменения сессии"

#: lib/main_image_builder.py:213
msgid "The existing session layer is treated as part of the source, so you can continue modifying the image. To omit that saved session, disable the corresponding *-session-changes.sb module in the module list. If you include changes from the current session, a new layer is added after the existing source modules."
msgstr "Существующий слой сессии рассматривается как часть исходника, поэтому вы можете продолжать редактировать образ. Чтобы исключить сохранённую сессию, отключите соответствующий модуль *-session-changes.sb в списке модулей. Если вы включаете изменения из текущей сессии, новый слой будет добавлен после уже существующих исходных модулей."

#: lib/main_image_builder.py:219
msgid "An added module uses a reserved session-layer name"
msgstr "Добавленный модуль использует зарезервированное имя слоя сессии"

#: lib/main_image_builder.py:220
msgid "Image Builder reserves *-session-changes.sb for session layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder резервирует *-session-changes.sb для слоёв сессии, которые создаёт автоматически. Переименуйте или удалите добавленный модуль перед сборкой."

#: lib/main_image_builder.py:223
msgid "Source was previously customized by Image Builder"
msgstr "Источник ранее был настроен с помощью Image Builder"

#: lib/main_image_builder.py:224
msgid "Existing customization data is treated as part of the source. You can continue and apply more changes; newly generated customization metadata replaces the previous report when required."
msgstr "Существующие данные кастомизации считаются частью источника. Вы можете продолжить и применить дополнительные изменения; новая метаинформация кастомизации заменит предыдущий отчёт при необходимости."

#: lib/main_image_builder.py:228
msgid "An added module uses a reserved customization-layer name"
msgstr "Добавленный модуль использует зарезервированное имя слоя кастомизации"

#: lib/main_image_builder.py:229
msgid "Image Builder reserves *-image-overlay.sb for project filesystem layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder резервирует *-image-overlay.sb для слоёв файловой системы проекта, которые он создаёт автоматически. Переименуйте или удалите добавленный модуль перед сборкой."

#: lib/main_image_builder.py:250 tests/test_runtime_integration.py:274
#, python-brace-format
msgid "The image backend reported: {error}"
msgstr "Бэкенд изображений сообщил: {error}"

