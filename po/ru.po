msgid "The image backend reported: {error}"
msgstr "Бэкенд изображений сообщил: {error}"

#: lib/main_image_builder.py:271 tests/test_runtime_integration.py:288
#, python-brace-format
msgid "The image command exited with status {status}."
msgstr "Команда создания образа завершилась со статусом {status}."

