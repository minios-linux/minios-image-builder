#: lib/main_image_builder.py:289
msgid "Do not include session changes"
msgstr "Не включать изменения сессии"

#: lib/main_image_builder.py:290
msgid "Build from the selected source modules and current configuration only. Changes made after MiniOS started are ignored."
msgstr "Собрать только из выбранных исходных модулей и текущей конфигурации. Изменения, внесённые после запуска MiniOS, будут проигнорированы."

#: lib/main_image_builder.py:292 lib/main_image_builder.py:3318
msgid "Recommended"
msgstr "Рекомендуется"

#: lib/main_image_builder.py:295
msgid "Include all session changes"
msgstr "Включить все изменения сессии"

#: lib/main_image_builder.py:296
msgid "Include every writable change that can be captured from the current session. This may include passwords, tokens, personal files, logs, and machine-specific state."
msgstr "Включить все доступные для записи изменения, которые можно зафиксировать из текущей сессии. Это может включать пароли, токены, личные файлы, журналы и состояние, специфичное для данного компьютера."

#: lib/main_image_builder.py:299 lib/main_image_builder.py:306
#: lib/main_image_builder.py:312 lib/main_image_builder.py:3327
msgid "Admin access"
msgstr "Доступ администратора"

#: lib/main_image_builder.py:302
msgid "Include reusable changes only"
msgstr "Включить только изменения, пригодные для повторного использования"

#: lib/main_image_builder.py:303
msgid "Include only allowlisted software and system settings intended for reuse. Personal data, identity, logs, caches, and other broad state are omitted."
msgstr "Включить только разрешённое программное обеспечение и системные настройки, предназначенные для повторного использования. Личные данные, идентификаторы, журналы, кэши и другие общие состояния не включаются."

#: lib/main_image_builder.py:309
msgid "Choose session changes manually"
msgstr "Выбрать изменения сессии вручную"

#: lib/main_image_builder.py:310
msgid "Analyze the current session and choose specific files or directories to include in the image."
msgstr "Проанализировать текущую сессию и выбрать конкретные файлы или каталоги для включения в образ."

#: lib/main_image_builder.py:321
msgid "Runtime state"
msgstr "Состояние среды выполнения"

#: lib/main_image_builder.py:322 lib/main_image_builder.py:2398
msgid "User data"
msgstr "Данные пользователя"

#: lib/main_image_builder.py:323
msgid "Logs and caches"
msgstr "Журналы и кэши"

#: lib/main_image_builder.py:324
msgid "Machine identity"
msgstr "Идентификатор машины"

#: lib/main_image_builder.py:325
msgid "Network identity"
msgstr "Сетевая идентификация"

#: lib/main_image_builder.py:326
msgid "Software"
msgstr "Программное обеспечение"

#: lib/main_image_builder.py:327
msgid "System configuration"
msgstr "Конфигурация системы"

#: lib/main_image_builder.py:328
msgid "Other"
msgstr "Другое"

#: lib/main_image_builder.py:332
msgid "File"
msgstr "Файл"

#: lib/main_image_builder.py:333
msgid "Directory"
msgstr "Каталог"

#: lib/main_image_builder.py:334
msgid "Symbolic link"
msgstr "Символическая ссылка"

#: lib/main_image_builder.py:335
msgid "Deletion marker"
msgstr "Маркер удаления"

#: lib/main_image_builder.py:336
msgid "Unsupported"
msgstr "Не поддерживается"

#: lib/main_image_builder.py:340
msgid "Resume saved session"
msgstr "Возобновить сохранённую сессию"

#: lib/main_image_builder.py:341
msgid "Start a new session"
msgstr "Начать новую сессию"

#: lib/main_image_builder.py:342
msgid "Choose at boot"
msgstr "Выбрать при загрузке"

#: lib/main_image_builder.py:343
msgid "Start fresh"
msgstr "Начать с нуля"

#: lib/main_image_builder.py:344
msgid "Copy the system to RAM"
msgstr "Скопировать систему в RAM"

#: lib/main_image_builder.py:348
msgid "Continue the most recent compatible saved session."
msgstr "Продолжить последнюю совместимую сохранённую сессию."

#: lib/main_image_builder.py:349
msgid "Always create a separate persistent session."
msgstr "Всегда создавать отдельную постоянную сессию."

#: lib/main_image_builder.py:350
msgid "Ask which saved session to use during startup."
msgstr "Спрашивать, какую сохранённую сессию использовать при запуске."

#: lib/main_image_builder.py:351
msgid "Start without loading persistent changes."
msgstr "Запустить без загрузки постоянных изменений."

#: lib/main_image_builder.py:352
msgid "Copy MiniOS to memory so the boot device can be removed."
msgstr "Скопировать MiniOS в память, чтобы можно было извлечь загрузочное устройство."

#: lib/main_image_builder.py:359
