#: lib/main_image_builder.py:2579
msgid "A root-relative directory tree becomes a final reusable filesystem layer. It does not run scripts, chroot operations, or package commands. Reusable .sb modules belong in Module Manager. The selected directory is never deleted."
msgstr "Дерево каталогов относительно корня становится финальным повторно используемым файловым слоем. Не выполняет скрипты, chroot-операции или команды пакетов. Повторно используемые .sb-модули размещаются в Менеджере модулей. Выбранный каталог никогда не удаляется."

#: lib/main_image_builder.py:2586
msgid "Choose existing"
msgstr "Выбрать существующий"

#: lib/main_image_builder.py:2592
