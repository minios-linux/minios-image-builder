#: lib/main_image_builder.py:2560
msgid "Choose what people see at startup. Each entry can have its own persistence, memory, module, graphics, language, and diagnostic settings."
msgstr "Выберите, что будет видно при запуске. Для каждого пункта можно задать свои параметры постоянства, памяти, модулей, графики, языка и диагностики."

#: lib/main_image_builder.py:2569
msgid "Boot menu constructor"
msgstr "Конструктор загрузочного меню"

#: lib/main_image_builder.py:2571
