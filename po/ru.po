msgstr "Анализ изменений в записываемой сессии"

#: lib/main_image_builder.py:294
msgid "Capturing writable session changes"
msgstr "Фиксация изменений в записываемой сессии"

#: lib/main_image_builder.py:295
msgid "Copying selected session changes"
msgstr "Копирование выбранных изменений сессии"

#: lib/main_image_builder.py:296
