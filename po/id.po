#: lib/main_image_builder.py:340
msgid "Resume saved session"
msgstr "Lanjutkan sesi yang disimpan"

#: lib/main_image_builder.py:341
msgid "Start a new session"
msgstr "Mulai sesi baru"

#: lib/main_image_builder.py:342
msgid "Choose at boot"
msgstr "Pilih saat boot"

#: lib/main_image_builder.py:343
msgid "Start fresh"
msgstr "Mulai dari awal"

#: lib/main_image_builder.py:344
msgid "Copy the system to RAM"
msgstr "Salin sistem ke RAM"

#: lib/main_image_builder.py:348
msgid "Continue the most recent compatible saved session."
msgstr "Lanjutkan sesi tersimpan terbaru yang kompatibel."

#: lib/main_image_builder.py:349
msgid "Always create a separate persistent session."
msgstr "Selalu buat sesi persisten terpisah."

#: lib/main_image_builder.py:350
msgid "Ask which saved session to use during startup."
msgstr "Tanyakan sesi tersimpan mana yang akan digunakan saat startup."

#: lib/main_image_builder.py:351
msgid "Start without loading persistent changes."
msgstr "Mulai tanpa memuat perubahan persisten."

#: lib/main_image_builder.py:352
msgid "Copy MiniOS to memory so the boot device can be removed."
msgstr "Salin MiniOS ke memori sehingga perangkat boot dapat dilepas."

#: lib/main_image_builder.py:359
msgid "no persistence selector"
msgstr "tidak ada pemilih persistensi"

#: lib/main_image_builder.py:503
msgid "Hostname"
msgstr "Hostname"

#: lib/main_image_builder.py:503
msgid "Keep current hostname"
msgstr "Pertahankan hostname saat ini"

#: lib/main_image_builder.py:504 lib/main_image_builder.py:2864
msgid "Timezone"
msgstr "Zona waktu"

#: lib/main_image_builder.py:504
msgid "Keep current timezone"
msgstr "Pertahankan zona waktu saat ini"

#: lib/main_image_builder.py:505
msgid "Enable services"
msgstr "Aktifkan layanan"

#: lib/main_image_builder.py:505 lib/main_image_builder.py:506
#: lib/main_image_builder.py:2824 lib/main_image_builder.py:3403
#: lib/main_image_builder.py:3908 lib/main_image_builder.py:4791
#: lib/main_image_builder.py:4827 lib/main_image_builder.py:5059
#: lib/main_image_builder.py:5675 lib/main_image_builder.py:5715
msgid "None"
msgstr "Tidak ada"

#: lib/main_image_builder.py:506
msgid "Disable services"
msgstr "Nonaktifkan layanan"

#: lib/main_image_builder.py:511
msgid ""
"Set the computer's network name (hostname).\n"
"\n"
"• Allowed characters: letters, numbers, hyphens.\n"
"• Example: 'minios-pc'.\n"
"\n"
"See: man 7 live-config (search 'hostname')"
msgstr ""
"Atur nama jaringan komputer (hostname).\n"
"\n"
"• Karakter yang diizinkan: huruf, angka, tanda hubung.\n"
"• Contoh: 'minios-pc'.\n"
"\n"
"Lihat: man 7 live-config (cari 'hostname')"

#: lib/main_image_builder.py:516
msgid ""
"Set the system timezone (e.g., 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affects system clock and displayed times.\n"
"\n"
"See: man 7 live-config (search 'timezone')"
msgstr ""
"Atur zona waktu sistem (misal: 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Mempengaruhi jam sistem dan waktu yang ditampilkan.\n"
"\n"
"Lihat: man 7 live-config (cari 'timezone')"

#: lib/main_image_builder.py:521
msgid ""
"Set the default boot target:\n"
"• 'graphical.target' – start with a desktop.\n"
"• 'multi-user.target' – console mode.\n"
"• 'rescue.target' – minimal rescue mode."
msgstr ""
"Atur target boot default:\n"
"• 'graphical.target' – mulai dengan desktop.\n"
"• 'multi-user.target' – mode konsol.\n"
"• 'rescue.target' – mode penyelamatan minimal."

#: lib/main_image_builder.py:526
msgid ""
"List services to enable at boot, separated by commas.\n"
"\n"
"• Example: 'ssh, NetworkManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Daftar layanan yang akan diaktifkan saat boot, pisahkan dengan koma.\n"
"\n"
"• Contoh: 'ssh, NetworkManager'.\n"
"• Nama unit systemd dan skrip sysvinit didukung."

#: lib/main_image_builder.py:530
msgid ""
"List services to disable at boot, separated by commas.\n"
"\n"
"• Example: 'bluetooth, ModemManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Daftar layanan yang akan dinonaktifkan saat boot, pisahkan dengan koma.\n"
"\n"
"• Contoh: 'bluetooth, ModemManager'.\n"
"• Nama unit systemd dan skrip sysvinit didukung."

#: lib/main_image_builder.py:534
msgid "Choose a preset to fill the settings below. You can customize any setting afterward. Only the individual settings are saved."
msgstr "Pilih preset untuk mengisi pengaturan di bawah ini. Anda dapat menyesuaikan pengaturan apa pun setelahnya. Hanya pengaturan individual yang akan disimpan."

#: lib/main_image_builder.py:537
msgid "passwordless keeps historical MiniOS behavior; password requires the user password; disabled removes the MiniOS sudo grant."
msgstr "passwordless mempertahankan perilaku historis MiniOS; password memerlukan sandi pengguna; disabled menghapus hak sudo MiniOS."

#: lib/main_image_builder.py:540
msgid "passwordless keeps historical MiniOS GUI admin convenience; password/disabled remove that rule and use normal PolicyKit authentication."
msgstr "passwordless mempertahankan kemudahan admin GUI MiniOS historis; password/disabled menghapus aturan itu dan menggunakan autentikasi PolicyKit normal."

#: lib/main_image_builder.py:544
msgid "Allow or deny root login through OpenSSH."
msgstr "Izinkan atau tolak login root melalui OpenSSH."

#: lib/main_image_builder.py:546
msgid "Allow or deny password authentication through OpenSSH."
msgstr "Izinkan atau tolak autentikasi kata sandi melalui OpenSSH."

#: lib/main_image_builder.py:548
msgid "relaxed keeps MiniOS defaults; hardened binds to localhost and disables root login; disabled disables common XRDP service links."
msgstr "relaxed mempertahankan default MiniOS; hardened mengikat ke localhost dan menonaktifkan login root; disabled menonaktifkan tautan layanan XRDP umum."

#: lib/main_image_builder.py:551
msgid "relaxed keeps compatibility; hardened removes the permissive -ac launch option and tightens Xwrapper where present."
msgstr "relaxed mempertahankan kompatibilitas; hardened menghapus opsi peluncuran -ac yang permisif dan memperketat Xwrapper jika ada."

#: lib/main_image_builder.py:554
msgid "relaxed keeps live-session convenience; hardened preserves/enables screen locking where supported."
msgstr "relaxed mempertahankan kemudahan live-session; hardened menjaga/mengaktifkan penguncian layar jika didukung."

#: lib/main_image_builder.py:557
msgid "Show default root/live password hints in /etc/issue."
msgstr "Tampilkan petunjuk sandi root/live default di /etc/issue."

#: lib/main_image_builder.py:559
msgid ""
"If enabled, user home directories will be symlinked to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'link-user-dirs')"
msgstr ""
"Jika diaktifkan, direktori home pengguna akan dibuat symlink ke penyimpanan persisten.\n"
"\n"
"• Menggunakan drive MiniOS dengan FAT32, exFAT, atau NTFS.\n"
"• Tidak tersedia jika menggunakan toram, toram=full, atau toram=trim.\n"
"• Folder yang bertabrakan dan tidak kosong tidak akan digabungkan secara otomatis.\n"
"\n"
"Lihat: man 7 live-config (cari 'link-user-dirs')"

#: lib/main_image_builder.py:566
msgid ""
"If enabled, user home directories will be bind-mounted to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'bind-user-dirs')"
msgstr ""
"Jika diaktifkan, direktori home pengguna akan di-bind mount ke penyimpanan persisten.\n"
"\n"
"• Menggunakan drive MiniOS dengan FAT32, exFAT, atau NTFS.\n"
"• Tidak tersedia jika menggunakan toram, toram=full, atau toram=trim.\n"
"• Folder yang bertabrakan dan tidak kosong tidak akan digabungkan secara otomatis.\n"
"\n"
"Lihat: man 7 live-config (cari 'bind-user-dirs')"

#: lib/main_image_builder.py:573
msgid ""
"Set the base path on persistent storage for user directories.\n"
"\n"
"• Example: '/minios/userdirs'.\n"
"\n"
"• The path must stay inside the MiniOS drive; '.', '..', and empty segments are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-dirs-path')"
msgstr ""
"Atur path dasar di penyimpanan persisten untuk direktori pengguna.\n"
"\n"
"• Contoh: '/minios/userdirs'.\n"
"\n"
"• Path harus tetap berada di dalam drive MiniOS; '.', '..', dan segmen kosong tidak diperbolehkan.\n"
"\n"
"Lihat: man 7 live-config (cari 'user-dirs-path')"

