#: lib/main_image_builder.py:92
msgid "Help content is unavailable."
msgstr "Konten bantuan tidak tersedia."

#: lib/main_image_builder.py:107
msgid "Base filesystem and essential system utilities."
msgstr "Filesystem dasar dan utilitas sistem esensial."

#: lib/main_image_builder.py:109
msgid "Linux kernel and hardware drivers."
msgstr "Kernel Linux dan driver perangkat keras."

#: lib/main_image_builder.py:111
msgid "Firmware for graphics, networking, and other devices."
msgstr "Firmware untuk grafis, jaringan, dan perangkat lainnya."

#: lib/main_image_builder.py:113
msgid "Display server and desktop graphics stack."
msgstr "Display server dan stack grafis desktop."

#: lib/main_image_builder.py:115
msgid "Desktop shell, window manager, and supporting applications."
msgstr "Shell desktop, manajer jendela, dan aplikasi pendukung."

#: lib/main_image_builder.py:116
msgid "Web browser and its runtime."
msgstr "Peramban web dan runtime-nya."

#: lib/main_image_builder.py:118
msgid "Additional command-line and system utilities."
msgstr "Utilitas command-line dan sistem tambahan."

#: lib/main_image_builder.py:119
msgid "Bundled user applications."
msgstr "Aplikasi pengguna yang dibundel."

#: lib/main_image_builder.py:120
msgid "A MiniOS SquashFS module."
msgstr "Modul MiniOS SquashFS."

#: lib/main_image_builder.py:125 tests/test_runtime_integration.py:138
msgid "Not enough space for the output image"
msgstr "Ruang tidak cukup untuk gambar output"

#: lib/main_image_builder.py:126
msgid "The selected output location does not have enough free space. Choose an output path on a filesystem with more free space."
msgstr "Lokasi output yang dipilih tidak memiliki ruang kosong yang cukup. Pilih jalur output pada filesystem dengan ruang kosong lebih banyak."

#: lib/main_image_builder.py:129
msgid "Output directory changed or became unavailable"
msgstr "Direktori output telah berubah atau tidak tersedia"

#: lib/main_image_builder.py:130
msgid "The selected output directory could not be retained safely. Return to Settings and choose the output location again."
msgstr "Direktori output yang dipilih tidak dapat dipertahankan dengan aman. Kembali ke Pengaturan dan pilih lokasi output lagi."

#: lib/main_image_builder.py:133
msgid "Existing output would be included before replacement"
msgstr "Output yang sudah ada akan disertakan sebelum diganti"

#: lib/main_image_builder.py:134
msgid "The selected output file already exists on the live writable layer. It could be included in the session changes before Image Builder replaces it. Choose a new filename, or move or remove the existing file first. A new image may be saved in this location."
msgstr "File output yang dipilih sudah ada di layer writable aktif. File tersebut bisa disertakan dalam perubahan sesi sebelum Image Builder menggantinya. Pilih nama file baru, atau pindahkan atau hapus file yang sudah ada terlebih dahulu. Image baru dapat disimpan di lokasi ini."

#: lib/main_image_builder.py:139 tests/test_runtime_integration.py:140
msgid "Not enough temporary workspace"
msgstr "Ruang kerja sementara tidak cukup"

#: lib/main_image_builder.py:140
msgid "The temporary work directory does not have enough free space. Choose another temporary work directory on the Settings page, or free space on its filesystem."
msgstr "Direktori kerja sementara tidak memiliki ruang kosong yang cukup. Pilih direktori kerja sementara lain di halaman Pengaturan, atau kosongkan ruang pada filesystem-nya."

#: lib/main_image_builder.py:144
msgid "Temporary work directory was not found"
msgstr "Direktori kerja sementara tidak ditemukan"

#: lib/main_image_builder.py:145
msgid "Choose an existing writable directory on the Settings page."
msgstr "Pilih direktori yang sudah ada dan dapat ditulis di halaman Pengaturan."

#: lib/main_image_builder.py:147
msgid "Temporary work directory is not writable"
msgstr "Direktori kerja sementara tidak dapat ditulis"

#: lib/main_image_builder.py:148
msgid "Choose a directory where your user can create and remove files."
msgstr "Pilih direktori di mana pengguna Anda dapat membuat dan menghapus file."

#: lib/main_image_builder.py:150
msgid "Temporary work directory cannot be a symbolic link"
msgstr "Direktori kerja sementara tidak boleh berupa symbolic link"

#: lib/main_image_builder.py:151
msgid "Choose the real directory instead of a symbolic link."
msgstr "Pilih direktori asli, bukan symbolic link."

#: lib/main_image_builder.py:153
msgid "Storage cannot protect temporary build files"
msgstr "Penyimpanan tidak dapat melindungi file build sementara"

#: lib/main_image_builder.py:154
msgid "Image Builder could not create a private directory with mode 0700 on this storage. Choose a filesystem with Unix permissions, such as ext4, XFS, or Btrfs."
msgstr "Image Builder tidak dapat membuat direktori privat dengan mode 0700 di media penyimpanan ini. Pilih filesystem dengan izin Unix, seperti ext4, XFS, atau Btrfs."

#: lib/main_image_builder.py:158
msgid "Temporary work directory became unavailable"
msgstr "Direktori kerja sementara menjadi tidak tersedia"

#: lib/main_image_builder.py:159
msgid "Check that the selected storage is still mounted, then choose the directory again."
msgstr "Periksa apakah penyimpanan yang dipilih masih terpasang, lalu pilih kembali direktori tersebut."

#: lib/main_image_builder.py:162
msgid "Temporary work directory path is invalid"
msgstr "Path direktori kerja sementara tidak valid"

#: lib/main_image_builder.py:163
msgid "Choose a directory whose path does not contain a line break."
msgstr "Pilih direktori dengan path yang tidak mengandung karakter baris baru."

#: lib/main_image_builder.py:165
msgid "Temporary work directory is not protected"
msgstr "Direktori kerja sementara tidak terlindungi"

#: lib/main_image_builder.py:166
msgid "Another user could replace files in the selected path while the image is being built. Choose a directory owned by you or root that is not shared for writing. Standard /tmp is also supported."
msgstr "Pengguna lain dapat mengganti file di path yang dipilih saat image sedang dibuat. Pilih direktori yang dimiliki oleh Anda atau root dan tidak dibagikan untuk penulisan. Standar /tmp juga didukung."

#: lib/main_image_builder.py:170
msgid "Temporary directory is inside the source image"
msgstr "Direktori sementara berada di dalam image sumber"

#: lib/main_image_builder.py:171
msgid "Choose a temporary work directory outside the mounted MiniOS source."
msgstr "Pilih direktori kerja sementara di luar sumber MiniOS yang terpasang."

#: lib/main_image_builder.py:174
msgid "Temporary directory is inside the project filesystem layer"
msgstr "Direktori sementara berada di dalam layer filesystem proyek"

#: lib/main_image_builder.py:175
msgid "Choose a temporary work directory outside the directory whose files are being added to the image."
msgstr "Pilih direktori kerja sementara di luar direktori yang file-filenya akan ditambahkan ke image."

#: lib/main_image_builder.py:178
msgid "Temporary files would be saved into the image"
msgstr "File sementara akan disimpan ke dalam image"

#: lib/main_image_builder.py:179
msgid "The selected directory is on the live writable layer. This build includes session changes, so its temporary files could be captured. Use /tmp when it is tmpfs, or choose disk-backed storage with Unix permissions such as ext4, XFS, or Btrfs."
msgstr "Direktori yang dipilih berada di layer writable aktif. Build ini menyertakan perubahan sesi, sehingga file sementara dapat ikut terekam. Gunakan /tmp jika berupa tmpfs, atau pilih penyimpanan berbasis disk dengan izin Unix seperti ext4, XFS, atau Btrfs."

#: lib/main_image_builder.py:184
msgid "Temporary directory is inside the changes being saved"
msgstr "Direktori sementara berada di dalam perubahan yang sedang disimpan"

#: lib/main_image_builder.py:185
msgid "Choose a temporary work directory outside the MiniOS changes directory, for example /tmp when it is tmpfs or disk-backed ext4, XFS, or Btrfs storage."
msgstr "Pilih direktori kerja sementara di luar direktori perubahan MiniOS, misalnya /tmp jika berupa tmpfs atau penyimpanan ext4, XFS, atau Btrfs berbasis disk."

#: lib/main_image_builder.py:189
msgid "Output and temporary files need more space"
msgstr "File output dan file sementara membutuhkan lebih banyak ruang"

#: lib/main_image_builder.py:190
msgid "The output image and temporary work directory are on the same filesystem, which does not have enough free space for both at the same time. Move either location to another filesystem or free additional space."
msgstr "Gambar output dan direktori kerja sementara berada pada filesystem yang sama, yang tidak memiliki ruang kosong yang cukup untuk keduanya secara bersamaan. Pindahkan salah satu lokasi ke filesystem lain atau kosongkan ruang tambahan."

#: lib/main_image_builder.py:195 tests/test_runtime_integration.py:150
msgid "Configuration may contain sensitive values"
msgstr "Konfigurasi mungkin mengandung nilai sensitif"

#: lib/main_image_builder.py:196
msgid "The current MiniOS configuration contains plaintext settings with sensitive-looking names. Image Builder copies their values unchanged into the new image but does not display or log them. Review the configuration before sharing the image."
msgstr "Konfigurasi MiniOS saat ini berisi pengaturan dalam bentuk teks biasa dengan nama yang tampak sensitif. Image Builder menyalin nilainya apa adanya ke dalam image baru tetapi tidak menampilkannya atau mencatatnya di log. Tinjau konfigurasi sebelum membagikan image."

#: lib/main_image_builder.py:201 tests/test_runtime_integration.py:152
msgid "Session-change size is unknown"
msgstr "Ukuran perubahan sesi tidak diketahui"

#: lib/main_image_builder.py:202
msgid "No complete analyzed session inventory is available for this estimate. Image Builder does not invent a size; analyze the current session changes on the Settings page if you need a more accurate space estimate."
msgstr "Tidak ada inventaris sesi yang telah dianalisis secara lengkap untuk estimasi ini. Image Builder tidak mengira-ngira ukuran; analisis perubahan sesi saat ini di halaman Pengaturan jika Anda membutuhkan estimasi ruang yang lebih akurat."

#: lib/main_image_builder.py:207 tests/test_runtime_integration.py:117
msgid "Reusable changes only"
msgstr "Hanya perubahan yang dapat digunakan ulang"

#: lib/main_image_builder.py:208 tests/test_runtime_integration.py:119
msgid "Clean capture uses a strict allowlist. It omits general system state, user data, identity files, logs, and caches."
msgstr "Clean capture menggunakan daftar izin yang ketat. Ini mengabaikan status sistem umum, data pengguna, file identitas, log, dan cache."

#: lib/main_image_builder.py:211 tests/test_runtime_integration.py:127
msgid "Source already contains saved session changes"
msgstr "Sumber sudah berisi perubahan sesi yang tersimpan"

#: lib/main_image_builder.py:212
msgid "The existing session layer is treated as part of the source, so you can continue modifying the image. To omit that saved session, disable the corresponding *-session-changes.sb module in the module list. If you include changes from the current session, a new layer is added after the existing source modules."
msgstr "Lapisan sesi yang ada dianggap sebagai bagian dari sumber, sehingga Anda dapat terus memodifikasi image. Untuk menghilangkan sesi yang tersimpan tersebut, nonaktifkan modul *-session-changes.sb yang sesuai di daftar modul. Jika Anda menyertakan perubahan dari sesi saat ini, sebuah lapisan baru akan ditambahkan setelah modul sumber yang sudah ada."

#: lib/main_image_builder.py:218
msgid "An added module uses a reserved session-layer name"
msgstr "Modul yang ditambahkan menggunakan nama lapisan sesi yang telah dicadangkan"

#: lib/main_image_builder.py:219
msgid "Image Builder reserves *-session-changes.sb for session layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder mencadangkan *-session-changes.sb untuk lapisan sesi yang dibuatnya sendiri. Ganti nama atau hapus modul yang ditambahkan sebelum membangun."

#: lib/main_image_builder.py:222
msgid "Source was previously customized by Image Builder"
msgstr "Sumber sebelumnya telah dikustomisasi oleh Image Builder"

#: lib/main_image_builder.py:223
msgid "Existing customization data is treated as part of the source. You can continue and apply more changes; newly generated customization metadata replaces the previous report when required."
msgstr "Data kustomisasi yang sudah ada dianggap sebagai bagian dari sumber. Anda dapat melanjutkan dan menerapkan perubahan tambahan; metadata kustomisasi yang baru akan menggantikan laporan sebelumnya jika diperlukan."

#: lib/main_image_builder.py:227
msgid "An added module uses a reserved customization-layer name"
msgstr "Modul yang ditambahkan menggunakan nama lapisan kustomisasi yang telah dicadangkan"

#: lib/main_image_builder.py:228
msgid "Image Builder reserves *-image-overlay.sb for project filesystem layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder mencadangkan *-image-overlay.sb untuk lapisan filesystem proyek yang dibuatnya sendiri. Ganti nama atau hapus modul yang ditambahkan sebelum membangun."

