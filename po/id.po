#: lib/main_image_builder.py:295
msgid "Include every writable change that can be captured from the current session. This may include passwords, tokens, personal files, logs, and machine-specific state."
msgstr "Sertakan setiap perubahan yang dapat ditulis dan dapat diambil dari sesi saat ini. Ini mungkin mencakup kata sandi, token, file pribadi, log, dan status spesifik mesin."

#: lib/main_image_builder.py:298 lib/main_image_builder.py:305
#: lib/main_image_builder.py:311 lib/main_image_builder.py:3339
msgid "Admin access"
msgstr "Akses admin"

#: lib/main_image_builder.py:301
msgid "Include reusable changes only"
msgstr "Sertakan hanya perubahan yang dapat digunakan ulang"

#: lib/main_image_builder.py:302
msgid "Include only allowlisted software and system settings intended for reuse. Personal data, identity, logs, caches, and other broad state are omitted."
msgstr "Hanya sertakan perangkat lunak dan pengaturan sistem yang diizinkan untuk digunakan ulang. Data pribadi, identitas, log, cache, dan status lain yang luas tidak disertakan."

#: lib/main_image_builder.py:308
msgid "Choose session changes manually"
msgstr "Pilih perubahan sesi secara manual"

#: lib/main_image_builder.py:309
msgid "Analyze the current session and choose specific files or directories to include in the image."
msgstr "Analisis sesi saat ini dan pilih file atau direktori spesifik yang ingin dimasukkan ke dalam image."

