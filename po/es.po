#: lib/main_image_builder.py:2002
msgid "ISO volume label"
msgstr "Etiqueta de volumen ISO"

#: lib/main_image_builder.py:2010
msgid "Path to the .iso file to create"
msgstr "Ruta al archivo .iso a crear"

#: lib/main_image_builder.py:2019
msgid "Output image"
msgstr "Imagen de salida"

#: lib/main_image_builder.py:2021
msgid "Use a writable disk with enough free space. Review checks both destination and scratch requirements."
msgstr "Utiliza un disco escribible con suficiente espacio libre. La revisión comprueba tanto los requisitos del destino como del área temporal."

#: lib/main_image_builder.py:2030
msgid "Current configuration"
msgstr "Configuración actual"

#: lib/main_image_builder.py:2031
msgid "The current /etc/live/config.conf is always included in the image because minios-image-compose requires it. Its bytes are copied verbatim into private build storage; values are not interpreted, shown, or logged."
msgstr "El archivo /etc/live/config.conf actual siempre se incluye en la imagen porque minios-image-compose lo requiere. Sus bytes se copian literalmente en el almacenamiento privado de compilación; los valores no se interpretan, muestran ni registran."

#: lib/main_image_builder.py:2040 lib/main_image_builder.py:2046
msgid "Changes from the current session"
msgstr "Cambios de la sesión actual"

#: lib/main_image_builder.py:2041
msgid "Choose whether changes made after this MiniOS session started should be copied into the new image. If you only want to change modules, configuration, and image settings, keep the first option."
msgstr "Elija si los cambios realizados después de iniciar esta sesión de MiniOS deben copiarse en la nueva imagen. Si solo desea modificar módulos, configuración y ajustes de imagen, mantenga la primera opción."

#: lib/main_image_builder.py:2047
msgid "A live MiniOS session has a writable layer containing changes made after startup, such as installed software, changed settings, logs, and user files."
msgstr "Una sesión en vivo de MiniOS tiene una capa editable que contiene los cambios realizados tras el inicio, como software instalado, configuraciones modificadas, registros y archivos de usuario."

#: lib/main_image_builder.py:2050
msgid "Which option should I choose?"
msgstr "¿Qué opción debo elegir?"

#: lib/main_image_builder.py:2051
msgid "Choose Do not include session changes when you only want the selected source modules and configuration. Choose Include all session changes to preserve the whole capturable writable layer. Choose Include reusable changes only for the narrow software/system allowlist. Choose Choose session changes manually when you want to inspect and select paths yourself."
msgstr "Elija No incluir los cambios de la sesión si solo desea los módulos fuente y la configuración seleccionados. Elija Incluir todos los cambios de la sesión para conservar toda la capa editable capturable. Elija Incluir solo cambios reutilizables para una lista restringida de software/sistema permitidos. Elija Seleccionar cambios de la sesión manualmente si desea inspeccionar y elegir las rutas usted mismo."

#: lib/main_image_builder.py:2058
msgid "Administrator access"
msgstr "Acceso de administrador"

#: lib/main_image_builder.py:2059
msgid "The first option does not capture the writable layer. The other options use trusted savechanges and may ask for administrator authorization; the image builder itself is not elevated."
msgstr "La primera opción no captura la capa editable. Las demás opciones usan savechanges de confianza y pueden requerir autorización de administrador; el generador de imágenes en sí no se ejecuta con privilegios elevados."

#: lib/main_image_builder.py:2063
msgid "Privacy"
msgstr "Privacidad"

#: lib/main_image_builder.py:2064
msgid "Including all session changes can copy passwords, tokens, personal files, logs, and machine identity. The reusable and manual modes reduce what is copied but are not a guarantee that an image is safe to share."
msgstr "Incluir todos los cambios de la sesión puede copiar contraseñas, tokens, archivos personales, registros e identidad de la máquina. Los modos reutilizable y manual reducen lo que se copia, pero no garantizan que la imagen sea segura para compartir."

#: lib/main_image_builder.py:2069
msgid "Explain session-change options"
msgstr "Explicar opciones de cambios de sesión"

#: lib/main_image_builder.py:2097
msgid "Session layer compression"
msgstr "Compresión de la capa de sesión"

#: lib/main_image_builder.py:2099
msgid "Compression applies only to a captured writable-session layer."
msgstr "La compresión solo se aplica a una capa de sesión escribible capturada."

#: lib/main_image_builder.py:2102
msgid "I understand that Include all session changes can preserve passwords, tokens, identity, personal files, logs, and other sensitive writable state. This acknowledgement is stored in the project and remains in effect until I revoke it"
msgstr "Entiendo que Incluir todos los cambios de la sesión puede conservar contraseñas, tokens, identidad, archivos personales, registros y otros datos sensibles en la capa editable. Este reconocimiento se almacena en el proyecto y permanece vigente hasta que lo revoque"

#: lib/main_image_builder.py:2117
msgid "Project notes"
msgstr "Notas del proyecto"

#: lib/main_image_builder.py:2132
msgid "Advanced exclusions"
msgstr "Exclusiones avanzadas"

#: lib/main_image_builder.py:2138
msgid "Expert option: this unchanged POSIX ERE can remove files from the source. A broad or invalid expression can make the image unbootable. Review blocks matches against mandatory inputs."
msgstr "Opción experta: esta ERE POSIX sin cambios puede eliminar archivos de la fuente. Una expresión amplia o inválida puede hacer que la imagen no sea arrancable. La revisión bloquea coincidencias contra entradas obligatorias."

#: lib/main_image_builder.py:2147
msgid "POSIX ERE, for example: ^docs/.*[.]tmp$"
msgstr "ERE POSIX, por ejemplo: ^docs/.*[.]tmp$"

#: lib/main_image_builder.py:2164
msgid "System defaults"
msgstr "Valores predeterminados del sistema"

#: lib/main_image_builder.py:2165
msgid "Optional allowlisted settings are appended safely to the live configuration. Empty fields and Keep current preserve the source value."
msgstr "Las configuraciones opcionales permitidas se agregan de forma segura a la configuración live. Los campos vacíos y la opción Conservar actual mantienen el valor de origen."

