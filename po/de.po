#: lib/main_image_builder.py:93
msgid "Help content is unavailable."
msgstr "Hilfsinhalt ist nicht verfügbar."

#: lib/main_image_builder.py:108
msgid "Base filesystem and essential system utilities."
msgstr "Basis-Dateisystem und essentielle Systemwerkzeuge."

#: lib/main_image_builder.py:110
msgid "Linux kernel and hardware drivers."
msgstr "Linux-Kernel und Hardware-Treiber."

#: lib/main_image_builder.py:112
msgid "Firmware for graphics, networking, and other devices."
msgstr "Firmware für Grafik, Netzwerk und andere Geräte."

#: lib/main_image_builder.py:114
msgid "Display server and desktop graphics stack."
msgstr "Anzeigeserver und Desktop-Grafik-Stack."

#: lib/main_image_builder.py:116
msgid "Desktop shell, window manager, and supporting applications."
msgstr "Desktop-Shell, Fenstermanager und unterstützende Anwendungen."

#: lib/main_image_builder.py:117
msgid "Web browser and its runtime."
msgstr "Webbrowser und seine Laufzeitumgebung."

#: lib/main_image_builder.py:119
msgid "Additional command-line and system utilities."
msgstr "Zusätzliche Kommandozeilen- und Systemwerkzeuge."

#: lib/main_image_builder.py:120
msgid "Bundled user applications."
msgstr "Mitgelieferte Benutzeranwendungen."

#: lib/main_image_builder.py:121
msgid "A MiniOS SquashFS module."
msgstr "Ein MiniOS SquashFS-Modul."

#: lib/main_image_builder.py:126 tests/test_runtime_integration.py:213
msgid "Not enough space for the output image"
msgstr "Nicht genügend Speicherplatz für das Ausgabebild"

#: lib/main_image_builder.py:127
msgid "The selected output location does not have enough free space. Choose an output path on a filesystem with more free space."
msgstr "Am gewählten Ausgabespeicherort ist nicht genug freier Speicherplatz vorhanden. Wählen Sie einen Ausgabepfad auf einem Dateisystem mit mehr freiem Speicherplatz."

#: lib/main_image_builder.py:130
msgid "Output directory changed or became unavailable"
msgstr "Ausgabeverzeichnis wurde geändert oder ist nicht mehr verfügbar"

#: lib/main_image_builder.py:131
msgid "The selected output directory could not be retained safely. Return to Settings and choose the output location again."
msgstr "Das ausgewählte Ausgabeverzeichnis konnte nicht sicher beibehalten werden. Kehren Sie zu den Einstellungen zurück und wählen Sie den Speicherort erneut aus."

#: lib/main_image_builder.py:134
msgid "Existing output would be included before replacement"
msgstr "Vorhandene Ausgaben würden vor dem Ersetzen einbezogen werden"

#: lib/main_image_builder.py:135
msgid "The selected output file already exists on the live writable layer. It could be included in the session changes before Image Builder replaces it. Choose a new filename, or move or remove the existing file first. A new image may be saved in this location."
msgstr "Die ausgewählte Ausgabedatei existiert bereits auf der aktiven beschreibbaren Ebene. Sie könnte in die Sitzungsänderungen aufgenommen werden, bevor Image Builder sie ersetzt. Wählen Sie einen neuen Dateinamen oder verschieben bzw. entfernen Sie die vorhandene Datei zuerst. Ein neues Abbild kann an diesem Ort gespeichert werden."

#: lib/main_image_builder.py:140 tests/test_runtime_integration.py:215
msgid "Not enough temporary workspace"
msgstr "Nicht genügend temporärer Arbeitsbereich"

#: lib/main_image_builder.py:141
msgid "The temporary work directory does not have enough free space. Choose another temporary work directory on the Settings page, or free space on its filesystem."
msgstr "Im temporären Arbeitsverzeichnis ist nicht genug freier Speicherplatz vorhanden. Wählen Sie auf der Einstellungsseite ein anderes temporäres Arbeitsverzeichnis oder schaffen Sie freien Speicherplatz auf dem entsprechenden Dateisystem."

#: lib/main_image_builder.py:145
msgid "Temporary work directory was not found"
msgstr "Temporäres Arbeitsverzeichnis wurde nicht gefunden"

#: lib/main_image_builder.py:146
msgid "Choose an existing writable directory on the Settings page."
msgstr "Wählen Sie auf der Einstellungsseite ein vorhandenes, beschreibbares Verzeichnis aus."

#: lib/main_image_builder.py:148
msgid "Temporary work directory is not writable"
msgstr "Temporäres Arbeitsverzeichnis ist nicht beschreibbar"

#: lib/main_image_builder.py:149
msgid "Choose a directory where your user can create and remove files."
msgstr "Wählen Sie ein Verzeichnis, in dem Ihr Benutzer Dateien erstellen und löschen kann."

#: lib/main_image_builder.py:151
msgid "Temporary work directory cannot be a symbolic link"
msgstr "Temporäres Arbeitsverzeichnis darf kein symbolischer Link sein"

#: lib/main_image_builder.py:152
msgid "Choose the real directory instead of a symbolic link."
msgstr "Wählen Sie stattdessen das echte Verzeichnis, nicht einen symbolischen Link."

#: lib/main_image_builder.py:154
msgid "Storage cannot protect temporary build files"
msgstr "Der Speicher kann temporäre Build-Dateien nicht schützen"

#: lib/main_image_builder.py:155
msgid "Image Builder could not create a private directory with mode 0700 on this storage. Choose a filesystem with Unix permissions, such as ext4, XFS, or Btrfs."
msgstr "Image Builder konnte auf diesem Speicher kein privates Verzeichnis mit Modus 0700 erstellen. Wählen Sie ein Dateisystem mit Unix-Berechtigungen wie ext4, XFS oder Btrfs."

#: lib/main_image_builder.py:159
msgid "Temporary work directory became unavailable"
msgstr "Temporäres Arbeitsverzeichnis ist nicht mehr verfügbar"

#: lib/main_image_builder.py:160
msgid "Check that the selected storage is still mounted, then choose the directory again."
msgstr "Überprüfen Sie, ob der ausgewählte Speicher noch eingehängt ist, und wählen Sie das Verzeichnis erneut aus."

#: lib/main_image_builder.py:163
msgid "Temporary work directory path is invalid"
msgstr "Der Pfad zum temporären Arbeitsverzeichnis ist ungültig"

#: lib/main_image_builder.py:164
msgid "Choose a directory whose path does not contain a line break."
msgstr "Wählen Sie ein Verzeichnis, dessen Pfad keinen Zeilenumbruch enthält."

#: lib/main_image_builder.py:166
msgid "Temporary work directory is not protected"
msgstr "Das temporäre Arbeitsverzeichnis ist nicht geschützt"

#: lib/main_image_builder.py:167
msgid "Another user could replace files in the selected path while the image is being built. Choose a directory owned by you or root that is not shared for writing. Standard /tmp is also supported."
msgstr "Ein anderer Benutzer könnte während des Erstellens des Images Dateien im ausgewählten Pfad ersetzen. Wählen Sie ein Verzeichnis, das Ihnen oder root gehört und nicht zum Schreiben freigegeben ist. Das Standard-/tmp wird ebenfalls unterstützt."

#: lib/main_image_builder.py:171
msgid "Temporary directory is inside the source image"
msgstr "Temporäres Verzeichnis befindet sich im Quell-Image"

#: lib/main_image_builder.py:172
msgid "Choose a temporary work directory outside the mounted MiniOS source."
msgstr "Wählen Sie ein temporäres Arbeitsverzeichnis außerhalb des eingebundenen MiniOS-Quellverzeichnisses."

#: lib/main_image_builder.py:175
msgid "Temporary directory is inside the project filesystem layer"
msgstr "Das temporäre Verzeichnis befindet sich innerhalb der Projekt-Dateisystemebene"

#: lib/main_image_builder.py:176
msgid "Choose a temporary work directory outside the directory whose files are being added to the image."
msgstr "Wählen Sie ein temporäres Arbeitsverzeichnis außerhalb des Verzeichnisses, dessen Dateien dem Image hinzugefügt werden."

#: lib/main_image_builder.py:179
msgid "Temporary files would be saved into the image"
msgstr "Temporäre Dateien würden im Image gespeichert werden"

#: lib/main_image_builder.py:180
msgid "The selected directory is on the live writable layer. This build includes session changes, so its temporary files could be captured. Use /tmp when it is tmpfs, or choose disk-backed storage with Unix permissions such as ext4, XFS, or Btrfs."
msgstr "Das ausgewählte Verzeichnis befindet sich auf der aktiven beschreibbaren Ebene. Dieser Build enthält Sitzungsänderungen, daher könnten temporäre Dateien erfasst werden. Verwenden Sie /tmp, wenn es sich um tmpfs handelt, oder wählen Sie einen festplattenbasierten Speicher mit Unix-Berechtigungen wie ext4, XFS oder Btrfs."

#: lib/main_image_builder.py:185
msgid "Temporary directory is inside the changes being saved"
msgstr "Temporäres Verzeichnis befindet sich innerhalb der zu speichernden Änderungen"

#: lib/main_image_builder.py:186
msgid "Choose a temporary work directory outside the MiniOS changes directory, for example /tmp when it is tmpfs or disk-backed ext4, XFS, or Btrfs storage."
msgstr "Wählen Sie ein temporäres Arbeitsverzeichnis außerhalb des MiniOS Änderungsverzeichnisses, zum Beispiel /tmp, wenn es sich um tmpfs oder festplattenbasierten ext4-, XFS- oder Btrfs-Speicher handelt."

#: lib/main_image_builder.py:190
msgid "Output and temporary files need more space"
msgstr "Für Ausgabe- und temporäre Dateien wird mehr Speicherplatz benötigt"

#: lib/main_image_builder.py:191
msgid "The output image and temporary work directory are on the same filesystem, which does not have enough free space for both at the same time. Move either location to another filesystem or free additional space."
msgstr "Das Ausgabebild und das temporäre Arbeitsverzeichnis befinden sich auf demselben Dateisystem, das nicht genügend freien Speicherplatz für beide gleichzeitig bietet. Verschieben Sie einen der Speicherorte auf ein anderes Dateisystem oder schaffen Sie zusätzlichen Speicherplatz."

#: lib/main_image_builder.py:196 tests/test_runtime_integration.py:225
msgid "Configuration may contain sensitive values"
msgstr "Konfiguration könnte sensible Werte enthalten"

#: lib/main_image_builder.py:197
msgid "The current MiniOS configuration contains plaintext settings with sensitive-looking names. Image Builder copies their values unchanged into the new image but does not display or log them. Review the configuration before sharing the image."
msgstr "Die aktuelle MiniOS-Konfiguration enthält Klartext-Einstellungen mit sensiblen Namen. Image Builder übernimmt deren Werte unverändert in das neue Image, zeigt sie jedoch nicht an und protokolliert sie nicht. Überprüfen Sie die Konfiguration, bevor Sie das Image weitergeben."

#: lib/main_image_builder.py:202 tests/test_runtime_integration.py:227
msgid "Session-change size is unknown"
msgstr "Größe der Sitzungsänderung ist unbekannt"

#: lib/main_image_builder.py:203
msgid "No complete analyzed session inventory is available for this estimate. Image Builder does not invent a size; analyze the current session changes on the Settings page if you need a more accurate space estimate."
msgstr "Für diese Schätzung ist kein vollständiges, analysiertes Sitzungsinventar verfügbar. Image Builder schätzt keine Größe; analysieren Sie die aktuellen Sitzungsänderungen auf der Einstellungsseite, wenn Sie eine genauere Speicherplatzschätzung benötigen."

#: lib/main_image_builder.py:208 tests/test_runtime_integration.py:192
msgid "Reusable changes only"
msgstr "Nur wiederverwendbare Änderungen"

#: lib/main_image_builder.py:209 tests/test_runtime_integration.py:194
msgid "Clean capture uses a strict allowlist. It omits general system state, user data, identity files, logs, and caches."
msgstr "Clean Capture verwendet eine strikte Allowlist. Allgemeiner Systemstatus, Benutzerdaten, Identitätsdateien, Protokolle und Caches werden ausgelassen."

#: lib/main_image_builder.py:212
msgid "Session changes are unavailable for this source"
msgstr "Sitzungsänderungen sind für diese Quelle nicht verfügbar"

#: lib/main_image_builder.py:213
msgid "Changes from the running MiniOS session cannot be combined with an ISO image file or optical disc selected as a separate source. Use the running session source, or build this image without session changes."
msgstr "Änderungen aus der laufenden MiniOS-Sitzung können nicht mit einer als separate Quelle ausgewählten ISO-Abbilddatei oder optischen Disc kombiniert werden. Verwenden Sie die laufende Sitzungsquelle oder erstellen Sie dieses Abbild ohne Sitzungsänderungen."

#: lib/main_image_builder.py:218
msgid "Session changes require the complete running source"
msgstr "Sitzungsänderungen erfordern die vollständige laufende Quelle"

#: lib/main_image_builder.py:219
msgid "One or more source modules have been excluded. Keep every source module from the running MiniOS system, or build the image without session changes."
msgstr "Ein oder mehrere Quellmodule wurden ausgeschlossen. Behalten Sie jedes Quellmodul aus dem laufenden MiniOS-System bei oder erstellen Sie das Abbild ohne Sitzungsänderungen."

#: lib/main_image_builder.py:223
msgid "Session changes require all active root modules"
msgstr "Sitzungsänderungen erfordern alle aktiven Root-Module"

#: lib/main_image_builder.py:224
msgid "One or more active external modules from the running MiniOS root are not included. Include every active external module, or build the image without session changes."
msgstr "Ein oder mehrere aktive externe Module aus dem laufenden MiniOS-Root sind nicht enthalten. Fügen Sie jedes aktive externe Modul hinzu oder erstellen Sie das Abbild ohne Sitzungsänderungen."

#: lib/main_image_builder.py:228
msgid "Running source is unavailable for session changes"
msgstr "Laufende Quelle ist für Sitzungsänderungen nicht verfügbar"

#: lib/main_image_builder.py:229
msgid "Refresh the running MiniOS source before including session changes."
msgstr "Aktualisieren Sie die laufende MiniOS-Quelle, bevor Sie Sitzungsänderungen einbeziehen."

#: lib/main_image_builder.py:231 tests/test_runtime_integration.py:202
msgid "Source already contains saved session changes"
msgstr "Die Quelle enthält bereits gespeicherte Sitzungsänderungen"

#: lib/main_image_builder.py:232
msgid "The existing session layer is treated as part of the source, so you can continue modifying the image. To omit that saved session, disable the corresponding *-session-changes.sb module in the module list. If you include changes from the current session, a new layer is added after the existing source modules."
msgstr "Die vorhandene Sitzungs-Schicht wird als Teil der Quelle behandelt, sodass Sie das Image weiterhin bearbeiten können. Um diese gespeicherte Sitzung auszulassen, deaktivieren Sie das entsprechende *-session-changes.sb Modul in der Modulliste. Wenn Sie Änderungen aus der aktuellen Sitzung einbeziehen, wird nach den bestehenden Quellmodulen eine neue Schicht hinzugefügt."

#: lib/main_image_builder.py:238
msgid "An added module uses a reserved session-layer name"
msgstr "Ein hinzugefügtes Modul verwendet einen reservierten Sitzungs-Schichtnamen"

#: lib/main_image_builder.py:239
msgid "Image Builder reserves *-session-changes.sb for session layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder reserviert *-session-changes.sb für Sitzungs-Schichten, die es selbst erstellt. Benennen Sie das hinzugefügte Modul um oder entfernen Sie es, bevor Sie bauen."

#: lib/main_image_builder.py:242
msgid "Source was previously customized by Image Builder"
msgstr "Die Quelle wurde zuvor vom Image Builder angepasst"

#: lib/main_image_builder.py:243
msgid "Existing customization data is treated as part of the source. You can continue and apply more changes; newly generated customization metadata replaces the previous report when required."
msgstr "Vorhandene Anpassungsdaten werden als Teil der Quelle behandelt. Sie können fortfahren und weitere Änderungen anwenden; neu generierte Anpassungsmetadaten ersetzen bei Bedarf den vorherigen Bericht."

#: lib/main_image_builder.py:247
msgid "An added module uses a reserved customization-layer name"
msgstr "Ein hinzugefügtes Modul verwendet einen reservierten Anpassungs-Schichtnamen"

#: lib/main_image_builder.py:248
msgid "Image Builder reserves *-image-overlay.sb for project filesystem layers it creates itself. Rename or remove the added module before building."
msgstr "Image Builder reserviert *-image-overlay.sb für Projekt-Dateisystemschichten, die es selbst erstellt. Benennen Sie das hinzugefügte Modul um oder entfernen Sie es, bevor Sie bauen."

#: lib/main_image_builder.py:269 tests/test_runtime_integration.py:286
