msgstr "Beim Start auswählen"

#: lib/main_image_builder.py:339
msgid "Start fresh"
msgstr "Neu starten"

#: lib/main_image_builder.py:340
msgid "Copy the system to RAM"
msgstr "System in den RAM kopieren"

#: lib/main_image_builder.py:344
msgid "Continue the most recent compatible saved session."
msgstr "Die zuletzt kompatible gespeicherte Sitzung fortsetzen."

#: lib/main_image_builder.py:345
msgid "Always create a separate persistent session."
msgstr "Immer eine separate persistente Sitzung erstellen."

#: lib/main_image_builder.py:346
msgid "Ask which saved session to use during startup."
msgstr "Beim Start auswählen, welche gespeicherte Sitzung verwendet werden soll."

#: lib/main_image_builder.py:347
msgid "Start without loading persistent changes."
msgstr "Ohne Laden persistenter Änderungen starten."

#: lib/main_image_builder.py:348
msgid "Copy MiniOS to memory so the boot device can be removed."
msgstr "MiniOS in den Arbeitsspeicher kopieren, damit das Boot-Medium entfernt werden kann."

#: lib/main_image_builder.py:355
msgid "no persistence selector"
msgstr "Kein Persistenz-Auswahldialog"

#: lib/main_image_builder.py:499
msgid "Hostname"
msgstr "Hostname"

#: lib/main_image_builder.py:499
msgid "Keep current hostname"
msgstr "Aktuellen Hostnamen beibehalten"

#: lib/main_image_builder.py:500 lib/main_image_builder.py:2873
msgid "Timezone"
msgstr "Zeitzone"

#: lib/main_image_builder.py:500
msgid "Keep current timezone"
msgstr "Aktuelle Zeitzone beibehalten"

#: lib/main_image_builder.py:501
msgid "Enable services"
msgstr "Dienste aktivieren"

#: lib/main_image_builder.py:501 lib/main_image_builder.py:502
#: lib/main_image_builder.py:2833 lib/main_image_builder.py:3412
#: lib/main_image_builder.py:3917 lib/main_image_builder.py:4835
