    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The entry template controls whether MiniOS resumes the latest session, creates"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "a new one, or asks at startup. The storage type does not replace that template"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "choice."
        ]
      ]
    ],
