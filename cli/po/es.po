#: bin/minios-image-compose:96 bin/minios-image-compose:134
msgid "Usage"
msgstr "Uso"

#: bin/minios-image-compose:97
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "Genera una imagen ISO de MiniOS, añadiendo los módulos especificados."

#: bin/minios-image-compose:98
msgid "Options"
msgstr "Opciones"

#: bin/minios-image-compose:99
msgid "Exclude any existing path or file matching REGEX"
msgstr "Excluye cualquier ruta o archivo existente que coincida con la expresión regular REGEX"

#: bin/minios-image-compose:100
msgid "Specify output ISO filename (default: minios-YYYYMMDD_HHMM.iso)"
msgstr "Especifica el nombre de archivo de salida ISO (por defecto: minios-YYYYMMDD_HHMM.iso)"

#: bin/minios-image-compose:101
msgid "Use this MiniOS content root instead of live-system discovery"
msgstr "Usa este directorio raíz de contenido de MiniOS en lugar del descubrimiento del sistema en vivo"

#: bin/minios-image-compose:102
msgid "Graft FILE as minios/config.conf (default: /etc/live/config.conf)"
msgstr "Incorpora el archivo FILE como minios/config.conf (por defecto: /etc/live/config.conf)"

#: bin/minios-image-compose:103
msgid "Set the ISO volume label (default: MINIOS)"
msgstr "Establece la etiqueta de volumen ISO (por defecto: MINIOS)"

#: bin/minios-image-compose:104
msgid "Graft a JSON manifest as minios/build-manifest.json"
msgstr "Incorpora un manifiesto JSON como minios/build-manifest.json"

#: bin/minios-image-compose:106
msgid "Capture session changes: exact, clean, or selected"
msgstr "Captura los cambios de la sesión: exacto, limpio o seleccionado"

#: bin/minios-image-compose:108
msgid "Selection JSON required by selected session capture"
msgstr "Se requiere un JSON de selección para la captura de sesión seleccionada"

#: bin/minios-image-compose:110
msgid "Session module compression: zstd, gzip, lzo, or xz"
msgstr "Compresión del módulo de sesión: zstd, gzip, lzo o xz"

#: bin/minios-image-compose:112
msgid "Set effective GRUB and SYSLINUX timeout (0 to 300 seconds)"
msgstr "Establece el tiempo de espera efectivo de GRUB y SYSLINUX (0 a 300 segundos)"

#: bin/minios-image-compose:113
msgid "Default session: resume, new, choose, fresh, or toram"
msgstr "Sesión predeterminada: resume, new, choose, fresh o toram"

#: bin/minios-image-compose:114
msgid "Append safe kernel arguments to every effective kernel line"
msgstr "Agrega argumentos seguros del kernel a cada línea efectiva del kernel"

#: bin/minios-image-compose:115
msgid "Use a validated PNG for MiniOS boot backgrounds"
msgstr "Usa un PNG validado para los fondos de arranque de MiniOS"

#: bin/minios-image-compose:117
msgid "Package one absolute directory tree as an image overlay module"
msgstr "Empaqueta un árbol de directorios absoluto como un módulo de superposición de imagen"

#: bin/minios-image-compose:118
msgid "Set menu type: multilang or language code"
msgstr "Establece el tipo de menú: multilang o código de idioma"

#: bin/minios-image-compose:119
msgid "multilang: menu with language selection (default)"
msgstr "multilang: menú con selección de idioma (por defecto)"

#: bin/minios-image-compose:120
msgid "language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "language: idioma específico (en_US, ru_RU, de_DE, etc.)"

#: bin/minios-image-compose:121
msgid "Replace an existing output file"
msgstr "Reemplaza un archivo de salida existente"

#: bin/minios-image-compose:122
msgid "Disable colored output"
msgstr "Desactiva la salida en color"

#: bin/minios-image-compose:123
msgid "Display this help and exit"
msgstr "Muestra esta ayuda y sale"

#: bin/minios-image-compose:124
msgid "Display version information and exit"
msgstr "Muestra la información de versión y sale"

#: bin/minios-image-compose:125
msgid "Examples"
msgstr "Ejemplos"

#: bin/minios-image-compose:135
msgid "Try"
msgstr "Prueba"

#: bin/minios-image-compose:135
msgid "for more information."
msgstr "para más información."

