#: bin/minios-image-compose:100 bin/minios-image-compose:139
msgid "Usage"
msgstr "Uso"

#: bin/minios-image-compose:101
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "Gerar imagem ISO do MiniOS, adicionando os módulos especificados."

#: bin/minios-image-compose:102
msgid "Options"
msgstr "Opções"

#: bin/minios-image-compose:103
msgid "Exclude any existing path or file matching REGEX"
msgstr "Excluir qualquer caminho ou arquivo existente que corresponda ao REGEX"

#: bin/minios-image-compose:104
msgid "Specify output ISO filename (default: minios-YYYYMMDD_HHMM.iso)"
msgstr "Especificar o nome do arquivo ISO de saída (padrão: minios-YYYYMMDD_HHMM.iso)"

#: bin/minios-image-compose:105
msgid "Use this MiniOS content root instead of live-system discovery"
msgstr "Usar este diretório raiz de conteúdo do MiniOS em vez da detecção automática do sistema live"

#: bin/minios-image-compose:106
msgid "Graft FILE as minios/config.conf (default: /etc/live/config.conf)"
msgstr "Adicionar o arquivo FILE como minios/config.conf (padrão: /etc/live/config.conf)"

#: bin/minios-image-compose:107
msgid "Set the ISO volume label (default: MINIOS)"
msgstr "Definir o rótulo do volume ISO (padrão: MINIOS)"

#: bin/minios-image-compose:108
msgid "Graft a JSON manifest as minios/build-manifest.json"
msgstr "Adicionar um manifesto JSON como minios/build-manifest.json"

#: bin/minios-image-compose:110
msgid "Capture session changes: exact, clean, or selected"
msgstr "Capturar alterações da sessão: exata, limpa ou selecionada"

#: bin/minios-image-compose:112
msgid "Selection JSON required by selected session capture"
msgstr "JSON de seleção obrigatório para captura de sessão selecionada"

#: bin/minios-image-compose:114
msgid "Session module compression: zstd, gzip, lzo, or xz"
msgstr "Compressão de módulo de sessão: zstd, gzip, lzo ou xz"

#: bin/minios-image-compose:116
msgid "Set effective GRUB and SYSLINUX timeout (0 to 300 seconds)"
msgstr "Definir o tempo limite efetivo do GRUB e SYSLINUX (0 a 300 segundos)"

#: bin/minios-image-compose:117
msgid "Default session: resume, new, choose, fresh, or toram"
msgstr "Sessão padrão: resume, new, choose, fresh ou toram"

#: bin/minios-image-compose:118
msgid "Construct MiniOS boot-menu entries with per-entry parameters"
msgstr "Construa entradas do MiniOS boot-menu com parâmetros específicos por entrada"

#: bin/minios-image-compose:119
msgid "Append safe kernel arguments to every effective kernel line"
msgstr "Adicionar argumentos seguros do kernel a todas as linhas efetivas do kernel"

#: bin/minios-image-compose:120
msgid "Use a validated PNG for MiniOS boot backgrounds"
msgstr "Usar um PNG validado para fundos de boot do MiniOS"

#: bin/minios-image-compose:122
msgid "Package one absolute directory tree as an image overlay module"
msgstr "Empacotar uma árvore de diretórios absoluta como um módulo de sobreposição de imagem"

#: bin/minios-image-compose:123
msgid "Set menu type: multilang or language code"
msgstr "Definir tipo de menu: multilang ou código de idioma"

#: bin/minios-image-compose:124
msgid "multilang: menu with language selection (default)"
msgstr "multilang: menu com seleção de idioma (padrão)"

#: bin/minios-image-compose:125
msgid "language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "language: idioma específico (en_US, ru_RU, de_DE, etc.)"

#: bin/minios-image-compose:126
msgid "Replace an existing output file"
msgstr "Substituir um arquivo de saída existente"

#: bin/minios-image-compose:127
msgid "Disable colored output"
msgstr "Desativar saída colorida"

#: bin/minios-image-compose:128
msgid "Display this help and exit"
msgstr "Exibir esta ajuda e sair"

#: bin/minios-image-compose:129
msgid "Display version information and exit"
msgstr "Exibir informações da versão e sair"

#: bin/minios-image-compose:130
msgid "Examples"
msgstr "Exemplos"

#: bin/minios-image-compose:140
msgid "Try"
msgstr "Tente"

#: bin/minios-image-compose:140
msgid "for more information."
msgstr "para mais informações."

