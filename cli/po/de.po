#: bin/minios-image-compose:100 bin/minios-image-compose:139
msgid "Usage"
msgstr "Verwendung"

#: bin/minios-image-compose:101
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "MiniOS-ISO-Abbild erzeugen und angegebene Module hinzufügen."

#: bin/minios-image-compose:102
msgid "Options"
msgstr "Optionen"

#: bin/minios-image-compose:103
msgid "Exclude any existing path or file matching REGEX"
msgstr "Schließt alle vorhandenen Pfade oder Dateien aus, die auf REGEX passen"

#: bin/minios-image-compose:104
msgid "Specify output ISO filename (default: minios-YYYYMMDD_HHMM.iso)"
msgstr "Gibt den Namen der Ausgabedatei für das ISO an (Standard: minios-YYYYMMDD_HHMM.iso)"

#: bin/minios-image-compose:105
msgid "Use this MiniOS content root instead of live-system discovery"
msgstr "Verwenden Sie dieses MiniOS-Content-Root anstelle der Live-System-Erkennung"

#: bin/minios-image-compose:106
msgid "Graft FILE as minios/config.conf (default: /etc/live/config.conf)"
msgstr "DATEI als minios/config.conf einbinden (Standard: /etc/live/config.conf)"

#: bin/minios-image-compose:107
msgid "Set the ISO volume label (default: MINIOS)"
msgstr "Setzt das ISO-Volume-Label (Standard: MINIOS)"

#: bin/minios-image-compose:108
msgid "Graft a JSON manifest as minios/build-manifest.json"
msgstr "Bindet ein JSON-Manifest als minios/build-manifest.json ein"

#: bin/minios-image-compose:110
msgid "Capture session changes: exact, clean, or selected"
msgstr "Sitzungsänderungen erfassen: exakt, bereinigt oder ausgewählt"

#: bin/minios-image-compose:112
msgid "Selection JSON required by selected session capture"
msgstr "Selection-JSON erforderlich für ausgewählte Sitzungsaufnahme"

#: bin/minios-image-compose:114
msgid "Session module compression: zstd, gzip, lzo, or xz"
msgstr "Komprimierung des Sitzungsmoduls: zstd, gzip, lzo oder xz"

