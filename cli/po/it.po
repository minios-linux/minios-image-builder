#: bin/minios-image-compose:96 bin/minios-image-compose:134
msgid "Usage"
msgstr "Utilizzo"

#: bin/minios-image-compose:97
msgid "Generate MiniOS ISO image, adding specified modules."
msgstr "Genera un'immagine ISO MiniOS aggiungendo i moduli specificati."

#: bin/minios-image-compose:98
msgid "Options"
msgstr "Opzioni"

#: bin/minios-image-compose:99
msgid "Exclude any existing path or file matching REGEX"
msgstr "Escludi qualsiasi percorso o file esistente che corrisponde a REGEX"

#: bin/minios-image-compose:100
msgid "Specify output ISO filename (default: minios-YYYYMMDD_HHMM.iso)"
msgstr "Specifica il nome del file ISO di output (predefinito: minios-YYYYMMDD_HHMM.iso)"

#: bin/minios-image-compose:101
msgid "Use this MiniOS content root instead of live-system discovery"
msgstr "Usa questa root di contenuti MiniOS invece del rilevamento live-system"

#: bin/minios-image-compose:102
msgid "Graft FILE as minios/config.conf (default: /etc/live/config.conf)"
msgstr "Innestare FILE come minios/config.conf (predefinito: /etc/live/config.conf)"

#: bin/minios-image-compose:103
msgid "Set the ISO volume label (default: MINIOS)"
msgstr "Imposta l'etichetta del volume ISO (predefinito: MINIOS)"

#: bin/minios-image-compose:104
msgid "Graft a JSON manifest as minios/build-manifest.json"
msgstr "Innestare un manifesto JSON come minios/build-manifest.json"

#: bin/minios-image-compose:106
msgid "Capture session changes: exact, clean, or selected"
msgstr "Cattura le modifiche della sessione: esatta, pulita o selezionata"

#: bin/minios-image-compose:108
msgid "Selection JSON required by selected session capture"
msgstr "JSON di selezione richiesto per la cattura sessione selezionata"

#: bin/minios-image-compose:110
msgid "Session module compression: zstd, gzip, lzo, or xz"
msgstr "Compressione modulo sessione: zstd, gzip, lzo o xz"

#: bin/minios-image-compose:112
msgid "Set effective GRUB and SYSLINUX timeout (0 to 300 seconds)"
msgstr "Imposta il timeout effettivo di GRUB e SYSLINUX (da 0 a 300 secondi)"

#: bin/minios-image-compose:113
msgid "Default session: resume, new, choose, fresh, or toram"
msgstr "Sessione predefinita: resume, new, choose, fresh o toram"

#: bin/minios-image-compose:114
msgid "Append safe kernel arguments to every effective kernel line"
msgstr "Aggiungi argomenti kernel sicuri a ogni riga kernel effettiva"

#: bin/minios-image-compose:115
msgid "Use a validated PNG for MiniOS boot backgrounds"
msgstr "Usa un PNG validato per gli sfondi di avvio MiniOS"

#: bin/minios-image-compose:117
msgid "Package one absolute directory tree as an image overlay module"
msgstr "Confeziona un albero di directory assoluto come modulo overlay dell'immagine"

#: bin/minios-image-compose:118
msgid "Set menu type: multilang or language code"
msgstr "Imposta il tipo di menu: multilang o codice lingua"

#: bin/minios-image-compose:119
msgid "multilang: menu with language selection (default)"
msgstr "multilang: menu con selezione lingua (predefinito)"

#: bin/minios-image-compose:120
msgid "language: specific language (en_US, ru_RU, de_DE, etc.)"
msgstr "language: lingua specifica (en_US, ru_RU, de_DE, ecc.)"

