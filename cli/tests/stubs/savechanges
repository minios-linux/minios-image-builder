#!/bin/bash

set -u

if [[ ${1:-} == --version ]]; then
    printf 'savechanges %s\n' "${SAVECHANGES_STUB_VERSION:-1.3.0}"
    exit 0
fi

state=${SAVECHANGES_STUB_STATE:?SAVECHANGES_STUB_STATE is required}
mkdir -p "$state"
printf '%s\0' "$@" >"$state/args"

profile=""
compression=""
selection=""
metadata=""
cancel_file=""
target=""
while (( $# > 0 )); do
    case $1 in
    --profile) profile=$2; shift 2 ;;
    --comp) compression=$2; shift 2 ;;
    --selection) selection=$2; shift 2 ;;
    --work-parent) shift 2 ;;
    --metadata-json) metadata=$2; shift 2 ;;
    --cancel-file) cancel_file=$2; shift 2 ;;
    --no-color) shift ;;
    *)
        if [[ -z $target ]]; then
            target=$1
        fi
        shift
        ;;
    esac
done

if [[ -z $cancel_file ]]; then
    printf 'E: savechanges stub requires --cancel-file\n' >&2
    exit 18
fi
cancel_parent=${cancel_file%/*}
cancel_stat=$(stat -c '%u %a' -- "$cancel_parent") || exit 18
read -r cancel_owner cancel_mode <<<"$cancel_stat"
expected_owner=${PKEXEC_UID:-$EUID}
if [[ $cancel_owner != "$expected_owner" || $cancel_mode != 700 || -e $cancel_file || -L $cancel_file ]]; then
    printf 'E: invalid savechanges stub cancel marker contract\n' >&2
    exit 18
fi

printf '%s\n' \
    'P:capture-inventory' \
    'I: stub inventory' \
    'P:capture-copy' \
    'I: stub copy' \
    'P:capture-compress' \
    'I: stub compression'

case ${SAVECHANGES_STUB_MODE:-success} in
root-stubborn)
    [[ $EUID -eq 0 ]] || exit 18
    trap '' TERM INT
    /usr/bin/python3 -c 'import signal, time
signal.signal(signal.SIGINT, signal.SIG_IGN)
signal.signal(signal.SIGTERM, signal.SIG_IGN)
while True:
    time.sleep(1)' &
    descendant_pid=$!
    printf '%s\n%s\n' "$$" "$descendant_pid" >"$state/root.started"
    while [[ ! -e $cancel_file && ! -L $cancel_file ]]; do
        sleep 0.05
    done
    kill -TERM "$descendant_pid" 2>/dev/null || true
    for _ in {1..20}; do
        kill -0 "$descendant_pid" 2>/dev/null || break
        sleep 0.05
    done
    kill -KILL "$descendant_pid" 2>/dev/null || true
    wait "$descendant_pid" 2>/dev/null || true
    rm -f -- "$target" "$metadata"
    printf '%s\n' 'P:cancelled' 'E: capture cancelled' >&2
    exit 130
    ;;
fail)
    printf 'E: savechanges stub requested failure\n' >&2
    exit 19
    ;;
empty)
    : >"$target"
    ;;
symlink)
    ln -s /etc/passwd "$target"
    ;;
*)
    printf 'captured session module\n' >"$target"
    ;;
esac

if [[ ${SAVECHANGES_STUB_MODE:-success} == success && -n $metadata ]]; then
    module_size=$(stat -c '%s' -- "$target")
    module_hash=$(sha256sum -- "$target")
    module_hash=${module_hash%% *}
    selection_hash=null
    if [[ -n $selection ]]; then
        selection_hash=$(sha256sum -- "$selection")
        selection_hash=\"${selection_hash%% *}\"
    fi
    base_fingerprint=${SAVECHANGES_STUB_BASE_FINGERPRINT:-}
    disable_auto_fingerprint=false
    if [[ $base_fingerprint == none ]]; then
        base_fingerprint=""
        disable_auto_fingerprint=true
    fi
    if [[ -z $base_fingerprint && $disable_auto_fingerprint == false && -n ${SAVECHANGES_STUB_SOURCE:-} ]]; then
        base_fingerprint=$(/usr/bin/python3 -I -c '
import hashlib, os, sys
import re
root = os.fsencode(sys.argv[1])
records = []
for directory, _directories, names in os.walk(root):
    for text_name in names:
        name = os.fsencode(text_name)
        path = os.path.join(directory, name)
        if not name.endswith(b".sb") or not os.path.isfile(path): continue
        digest = hashlib.sha256()
        with open(path, "rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""): digest.update(block)
        records.append((name, os.path.getsize(path), digest.hexdigest()))
result = hashlib.sha256(); result.update(b"minios-base-modules-v2\0")
records.sort(key=lambda item: (
    int(re.match(br"^[0-9]+", item[0]).group())
    if re.match(br"^[0-9]+", item[0]) else 0, item[0]), reverse=True)
for name, size, digest in records:
    result.update(name + b"\0" + str(size).encode() + b"\0" + digest.encode() + b"\0")
print(result.hexdigest())
' "$SAVECHANGES_STUB_SOURCE")
    fi
    base_json=null
    [[ -z $base_fingerprint ]] || base_json=\"$base_fingerprint\"
    module_size_json=$module_size
    module_hash_json=$module_hash
    entry_count_json=1
    uncompressed_size_json=8
    footprint_regular_bytes=8
    footprint_schema_version=1
    footprint_extra=""
    case ${SAVECHANGES_STUB_METADATA_MODE:-valid} in
    module-size) module_size_json=$((module_size + 1)) ;;
    module-digest) module_hash_json=$(printf '%064d' 0) ;;
    entry-count-type) entry_count_json=true ;;
    uncompressed-size-type) uncompressed_size_json=true ;;
    footprint-schema-type) footprint_schema_version=true ;;
    footprint-size) footprint_regular_bytes=9 ;;
    footprint-field) footprint_extra=',"unexpected":0' ;;
    esac
    printf '{"base_module_fingerprint":%s,"boot_id":"11111111-2222-3333-4444-555555555555","module":{"entry_count":%s,"extraction_footprint":{"block_size":1048576,"compressor":"%s","directory_count":1,"directory_entry_count":1,"filename_bytes":5,"hardlink_reference_count":0,"inode_count":2,"product_kind":"minios-extraction-footprint","regular_file_bytes":%s,"regular_file_inodes":1,"schema_version":%s,"symlink_count":0,"symlink_target_bytes":0,"whiteout_count":0,"xattr_count":0,"xattr_name_bytes":0,"xattr_value_bytes":0%s},"sha256":"%s","size":%s,"uncompressed_size":%s},"product_kind":"minios-session-capture-metadata","profile":"%s","schema_version":2,"selection_sha256":%s,"source_fingerprint":"%064d","union_backend":"overlayfs"}\n' \
        "$base_json" "$entry_count_json" "$compression" \
        "$footprint_regular_bytes" "$footprint_schema_version" \
        "$footprint_extra" "$module_hash_json" "$module_size_json" \
        "$uncompressed_size_json" "$profile" "$selection_hash" 0 >"$metadata"
    chmod 0600 "$target" "$metadata"
fi

printf '%s\n' 'P:capture-complete' 'I: stub capture complete'
