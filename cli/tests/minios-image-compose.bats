    write_file "$SOURCE/boot/grub/po/de_DE.po" $'msgid "MiniOS"\nmsgstr "MiniOS Deutsch"'

    run_compose --menu de_DE --boot-timeout 0 --default-boot toram

    [ "$status" -eq 0 ]
    grep -Fqx 'set timeout=0' "$STATE/files/minios/boot/grub/grub.cfg"
    grep -Fqx 'set default=4' "$STATE/files/minios/boot/grub/grub.cfg"
    [[ $(<"$STATE/files/minios/boot/grub/grub.cfg") == *'locales=de_DE.UTF-8'* ]]
