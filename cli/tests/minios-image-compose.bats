@test "real xorriso accepts reserved output and escaped graft pathspecs" {
    real_xorriso=$(PATH="$SYSTEM_PATH" command -v xorriso) ||
        skip 'xorriso is not installed'
    source_file=$'real source/odd [x]*=\\name\tfile'
    destination=$'minios/-odd [x]*=\\name\tfile'
    source_path="$TEST_ROOT/$source_file"
    empty_source="$TEST_ROOT/real empty directory"
    empty_destination='minios/empty target directory'
    image_path="$OUTPUT_DIR/real graft.iso"
    write_file "$source_path" real-data
    mkdir -p "$empty_source"
    : >"$image_path"

    escaped_destination=${destination//\\/\\\\}
    escaped_destination=${escaped_destination//=/\\=}
    escaped_source=${source_path//\\/\\\\}
    escaped_source=${escaped_source//=/\\=}
    escaped_empty_source=${empty_source//\\/\\\\}
    escaped_empty_source=${escaped_empty_source//=/\\=}
    run "$real_xorriso" -no_rc -as mkisofs -volid 'MINIOS LAB' -graft-points \
        "$escaped_destination=$escaped_source" \
        "$empty_destination=$escaped_empty_source" -output "$image_path"
    [ "$status" -eq 0 ]
    [ -s "$image_path" ]

    run "$real_xorriso" -no_rc -indev "$image_path" -pvd_info -sh_style_result on \
        -find / -exec echo -- -end
    [ "$status" -eq 0 ]
    [[ $output == *'Volume Id    : MINIOS LAB'* ]]
    [[ $output == *"/$destination"* ]]
    [[ $output == *"/$empty_destination"* ]]
}

@test "real-tool integration runs only with an explicit source fixture" {
    if [[ ${COMPOSE_RUN_REAL_INTEGRATION:-0} != 1 ||
          -z ${COMPOSE_REAL_SOURCE:-} || -z ${COMPOSE_REAL_CONFIG:-} ]]; then
        skip 'set COMPOSE_RUN_REAL_INTEGRATION=1, COMPOSE_REAL_SOURCE, and COMPOSE_REAL_CONFIG'
    fi

    real_output="$TEST_ROOT/real.iso"
    run env PATH="$SYSTEM_PATH" TMPDIR="$TEMP_ROOT" NO_COLOR=1 \
        "$COMPOSE" --source "$COMPOSE_REAL_SOURCE" \
        --config "$COMPOSE_REAL_CONFIG" --name "$real_output"
    [ "$status" -eq 0 ]
    [ -s "$real_output" ]
}
