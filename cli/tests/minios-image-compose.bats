#!/usr/bin/env bats
# shellcheck disable=SC2030,SC2031 # Each Bats test receives setup variables in its own subshell.

setup() {
    COMPOSE="$BATS_TEST_DIRNAME/../bin/minios-image-compose"
    STUBS="$BATS_TEST_DIRNAME/stubs"
    SYSTEM_PATH=$PATH
    TEST_ROOT="$BATS_TEST_TMPDIR/job $BATS_TEST_NUMBER"
    SOURCE="$TEST_ROOT/source tree = [x]\\root"
    CONFIG="$TEST_ROOT/config files/live config.conf"
    MANIFEST="$TEST_ROOT/manifests/build manifest.json"
    OUTPUT_DIR="$TEST_ROOT/output dir"
    OUTPUT="$OUTPUT_DIR/image partial.iso"
    STATE="$TEST_ROOT/xorriso state"
    TEMP_ROOT="$TEST_ROOT/tmp"
    CAPTURE_STUB="$TEST_ROOT/capture bin/savechanges"
    CAPTURE_STATE="$TEST_ROOT/savechanges state"
    PKEXEC_STUB="$TEST_ROOT/capture bin/pkexec"
    PKEXEC_STATE="$TEST_ROOT/pkexec state"
    TOOL_EUID_LOG="$TEST_ROOT/tool-euids.log"
    SESSION_SELECTION="$TEST_ROOT/session selection.json"
    OVERLAY_MKS_STUB="$TEST_ROOT/capture bin/mksquashfs"

    mkdir -p \
        "$SOURCE/boot/syslinux" \
        "$SOURCE/boot/grub/i386-pc" \
        "$SOURCE/boot/EFI/BOOT" \
        "$SOURCE/empty target" \
        "$SOURCE/modules" \
        "${CONFIG%/*}" \
        "${MANIFEST%/*}" \
        "$OUTPUT_DIR" \
        "$STATE" \
        "$CAPTURE_STATE" \
        "$PKEXEC_STATE" \
        "$TEMP_ROOT" \
        "${CAPTURE_STUB%/*}"

    write_file "$SOURCE/boot/syslinux/isolinux.bin" isolinux
    write_file "$SOURCE/boot/syslinux/isohdpfx.bin" isohybrid
    write_file "$SOURCE/boot/syslinux/syslinux.cfg" syslinux-config
    write_file "$SOURCE/boot/grub/efi.img" efi
    write_file "$SOURCE/boot/grub/grub.cfg" grub-config
    write_file "$SOURCE/boot/vmlinuz-test" kernel
    write_file "$SOURCE/boot/initrfs-test.img" initramfs
    write_file "$SOURCE/boot/EFI/BOOT/BOOTX64.EFI" efi-loader
    write_file "$SOURCE/00-core-amd64.sb" core-module
    write_file "$SOURCE/01-kernel-amd64.sb" kernel-module
    write_file "$CONFIG" configuration
    write_file "$MANIFEST" '{"schema_version":1}'
    cp "$STUBS/savechanges" "$CAPTURE_STUB"
    cp "$STUBS/pkexec" "$PKEXEC_STUB"
    cp "$STUBS/mksquashfs" "$OVERLAY_MKS_STUB"
    chmod 0755 "$CAPTURE_STUB" "$PKEXEC_STUB" "$OVERLAY_MKS_STUB"
    ln -s vmlinuz-test "$SOURCE/boot/kernel-link"
    ln -s '../empty target' "$SOURCE/boot/empty-directory-link"
}

write_file() {
    local path=$1
    shift
    mkdir -p "${path%/*}"
    printf '%s\n' "$*" >"$path"
}

prepare_custom_boot_fixture() {
    mkdir -p "$SOURCE/boot/syslinux/lang"
    write_file "$SOURCE/boot/grub/grub.cfg" $'set default=0\nset timeout=10\nmenuentry "English" {\n  configfile /minios/boot/grub/main.cfg\n}'
    write_file "$SOURCE/boot/grub/main.cfg" $'set default=0\nset timeout=10\nmenuentry "Translated resume" --class resume {\n  linux /minios/boot/vmlinuz-test boot=live quiet perchdir=resume\n}\nmenuentry "Translated new" --class new {\n  linux /minios/boot/vmlinuz-test boot=live quiet perchdir=new\n}\nmenuentry "Translated choose" --class switch {\n  linux /minios/boot/vmlinuz-test boot=live quiet perchdir=ask\n}\nmenuentry "Translated fresh" --class live {\n  linux /minios/boot/vmlinuz-test boot=live quiet\n}\nmenuentry "Translated RAM" --class ram {\n  linux /minios/boot/vmlinuz-test boot=live quiet toram\n}'
    write_file "$SOURCE/boot/syslinux/syslinux.cfg" $'PROMPT 0\nTIMEOUT 100\nLABEL en_US\nMENU LABEL English\nCONFIG lang/en_US.cfg\nLABEL ru_RU\nMENU LABEL Russian\nCONFIG lang/ru_RU.cfg'
    write_file "$SOURCE/boot/syslinux/lang/en_US.cfg" $'TIMEOUT 100\nONTIMEOUT default\nLABEL default\nMENU DEFAULT\nMENU LABEL Translated resume\nKERNEL /minios/boot/vmlinuz-test\nAPPEND boot=live quiet perchdir=resume\nLABEL perch\nMENU LABEL Translated new\nKERNEL /minios/boot/vmlinuz-test\nAPPEND boot=live quiet perchdir=new\nLABEL asksession\nMENU LABEL Translated choose\nKERNEL /minios/boot/vmlinuz-test\nAPPEND boot=live quiet perchdir=ask\nLABEL live\nMENU LABEL Translated fresh\nKERNEL /minios/boot/vmlinuz-test\nAPPEND boot=live quiet\nLABEL toram\nMENU LABEL Translated RAM\nKERNEL /minios/boot/vmlinuz-test\nAPPEND boot=live quiet toram'
    cp "$SOURCE/boot/syslinux/lang/en_US.cfg" "$SOURCE/boot/syslinux/lang/ru_RU.cfg"
}

prepare_syslinux_grub_fixture() {
    prepare_custom_boot_fixture
    write_file "$SOURCE/boot/grub/i386-pc/lnxboot.img" lnxboot
    write_file "$SOURCE/boot/grub/i386-pc/core.img" core
    # Generated by linux-live/minioslib for BOOTLOADER=syslinux-grub.
    write_file "$SOURCE/boot/syslinux/syslinux.cfg" $'PROMPT 0\nTIMEOUT 1\n\nDEFAULT grub2\n\nLABEL grub2\nMENU LABEL GRUB2\nLINUX /minios/boot/grub/i386-pc/lnxboot.img\nINITRD /minios/boot/grub/i386-pc/core.img'
}

create_test_png() {
    local output=$1
    local width=${2:-800}
    local height=${3:-600}
    python3 -c '
import struct, sys, zlib
width, height = int(sys.argv[2]), int(sys.argv[3])
def chunk(kind, payload):
    body = kind + payload
    return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body) & 0xffffffff)
ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
scanlines = b"".join(b"\0" + b"\0" * (width * 3) for _ in range(height))
data = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(scanlines)) + chunk(b"IEND", b"")
open(sys.argv[1], "wb").write(data)
' "$output" "$width" "$height"
}

prepare_real_iso_fixture() {
    REAL_XORRISO=$(PATH="$SYSTEM_PATH" command -v xorriso) || skip 'xorriso is not installed'
    REAL_MKSQUASHFS=$(PATH="$SYSTEM_PATH" command -v mksquashfs) || skip 'mksquashfs is not installed'
    PATH="$SYSTEM_PATH" command -v unsquashfs >/dev/null || skip 'unsquashfs is not installed'
    PATH="$SYSTEM_PATH" command -v mkfs.ext2 >/dev/null || skip 'mkfs.ext2 is not installed'

    rm -f "$SOURCE/00-core-amd64.sb" "$SOURCE/01-kernel-amd64.sb"
    module_root="$TEST_ROOT/real module root"
    mkdir -p "$module_root/core" "$module_root/kernel"
    write_file "$module_root/core/core.txt" core
    write_file "$module_root/kernel/kernel.txt" kernel
    "$REAL_MKSQUASHFS" "$module_root/core" "$SOURCE/00-core-amd64.sb" \
        -noappend -all-root -quiet
    "$REAL_MKSQUASHFS" "$module_root/kernel" "$SOURCE/01-kernel-amd64.sb" \
        -noappend -all-root -quiet

    python3 -c '
import os, sys
for relative, size in (("boot/syslinux/isolinux.bin", 4096),
                       ("boot/syslinux/isohdpfx.bin", 432),
                       ("boot/grub/efi.img", 1024 * 1024)):
    with open(os.path.join(sys.argv[1], relative), "wb") as stream:
        stream.write(b"\0" * size)
' "$SOURCE"
    write_file "$SOURCE/boot/syslinux/syslinux.cfg" $'PROMPT 0\nTIMEOUT 10\nDEFAULT live\nLABEL live\nKERNEL /minios/boot/vmlinuz-test\nAPPEND initrd=/minios/boot/initrfs-test.img boot=live'
    write_file "$SOURCE/boot/grub/grub.cfg" $'set default=0\nset timeout=10\nmenuentry "Fresh" --class live {\n  linux /minios/boot/vmlinuz-test boot=live\n  initrd /minios/boot/initrfs-test.img\n}'

    mkdir -p "$SOURCE/metadata"
    write_file "$SOURCE/metadata/executable" executable
    write_file "$SOURCE/metadata/plain" plain
    chmod 0755 "$SOURCE/metadata/executable"
    chmod 0644 "$SOURCE/metadata/plain"
    ln -s plain "$SOURCE/metadata/plain-link"
    truncate -s 17825792 "$SOURCE/metadata/large.bin"
    chmod 0644 "$SOURCE/metadata/large.bin"
    touch -d '@1700000000' "$SOURCE/metadata/executable" "$SOURCE/metadata/plain" \
        "$SOURCE/metadata/plain-link" "$SOURCE/metadata/large.bin"

    REAL_XORRISO_TOOLS="$TEST_ROOT/real xorriso tools"
    REAL_XORRISO_STATE="$TEST_ROOT/real xorriso state"
    mkdir -p "$REAL_XORRISO_TOOLS" "$REAL_XORRISO_STATE"
    cp "$STUBS/xorriso-real-wrapper" "$REAL_XORRISO_TOOLS/xorriso"
    chmod 0755 "$REAL_XORRISO_TOOLS/xorriso"
}

assert_process_gone() {
    local process_id=$1
    for _ in {1..100}; do
        kill -0 "$process_id" 2>/dev/null || return 0
        sleep 0.05
    done
    kill -KILL "$process_id" 2>/dev/null || true
    return 1
}

run_compose() {
    run env \
        PATH="$STUBS:$SYSTEM_PATH" \
        TMPDIR="$TEMP_ROOT" \
        XORRISO_STATE="$STATE" \
        XORRISO_BUILD_MODE="${XORRISO_BUILD_MODE:-success}" \
        XORRISO_OMIT_DEST="${XORRISO_OMIT_DEST:-}" \
        XORRISO_TAMPER_EXTRACT="${XORRISO_TAMPER_EXTRACT:-}" \
        XORRISO_MUTATE_GRAFT="${XORRISO_MUTATE_GRAFT:-}" \
        XORRISO_RACE_INPUT="${XORRISO_RACE_INPUT:-}" \
        XORRISO_RACE_INPUT_PARENT="${XORRISO_RACE_INPUT_PARENT:-}" \
        XORRISO_RACE_INPUT_VICTIM="${XORRISO_RACE_INPUT_VICTIM:-}" \
        XORRISO_RACE_OUTPUT_TARGET="${XORRISO_RACE_OUTPUT_TARGET:-}" \
        XORRISO_RACE_OUTPUT_PARENT="${XORRISO_RACE_OUTPUT_PARENT:-}" \
        XORRISO_RACE_OUTPUT_VICTIM="${XORRISO_RACE_OUTPUT_VICTIM:-}" \
        MKFS_EXT2_FAIL="${MKFS_EXT2_FAIL:-false}" \
        MKSQUASHFS_STATE="${MKSQUASHFS_STATE:-}" \
        MKSQUASHFS_SLEEP="${MKSQUASHFS_SLEEP:-false}" \
        MKSQUASHFS_SLEEP_MARKER="${MKSQUASHFS_SLEEP_MARKER:-}" \
        MKSQUASHFS_STUBBORN="${MKSQUASHFS_STUBBORN:-false}" \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 \
        MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        MINIOS_TOOLS_TEST_MOUNTINFO="${MINIOS_TOOLS_TEST_MOUNTINFO:-}" \
        MINIOS_TOOLS_TEST_CMDLINE="${MINIOS_TOOLS_TEST_CMDLINE:-}" \
        MINIOS_TOOLS_TEST_BOOT_ID="${MINIOS_TOOLS_TEST_BOOT_ID:-}" \
        MINIOS_TOOLS_TEST_RUNNING_SOURCE="${MINIOS_TOOLS_TEST_RUNNING_SOURCE:-}" \
        MINIOS_TOOLS_TEST_MKSQUASHFS="${MINIOS_TOOLS_TEST_MKSQUASHFS:-}" \
        MINIOS_TOOLS_TEST_UNSQUASHFS="${MINIOS_TOOLS_TEST_UNSQUASHFS:-}" \
        COMPOSE_TEST_SAVECHANGES="$CAPTURE_STUB" \
        COMPOSE_TEST_PKEXEC="$PKEXEC_STUB" \
        COMPOSE_TEST_CHANGES_ROOT="${COMPOSE_TEST_CHANGES_ROOT:-}" \
        COMPOSE_TEST_MKSQUASHFS="${COMPOSE_TEST_MKSQUASHFS:-$OVERLAY_MKS_STUB}" \
        COMPOSE_TEST_OVERLAY_PAUSE="${COMPOSE_TEST_OVERLAY_PAUSE:-}" \
        PKEXEC_STUB_STATE="$PKEXEC_STATE" \
        PKEXEC_STUB_ROOT="${PKEXEC_STUB_ROOT:-false}" \
        SAVECHANGES_STUB_STATE="$CAPTURE_STATE" \
        SAVECHANGES_STUB_MODE="${SAVECHANGES_STUB_MODE:-success}" \
        SAVECHANGES_STUB_METADATA_MODE="${SAVECHANGES_STUB_METADATA_MODE:-valid}" \
        SAVECHANGES_STUB_VERSION="${SAVECHANGES_STUB_VERSION:-1.3.0}" \
        SAVECHANGES_STUB_SOURCE="$SOURCE" \
        SAVECHANGES_STUB_BASE_FINGERPRINT="${SAVECHANGES_STUB_BASE_FINGERPRINT:-}" \
        UNSQUASHFS_FAIL_PATTERN="${UNSQUASHFS_FAIL_PATTERN:-__never__}" \
        UNSQUASHFS_TAMPER_TREE="${UNSQUASHFS_TAMPER_TREE:-}" \
        TOOL_EUID_LOG="$TOOL_EUID_LOG" \
        NO_COLOR=1 \
        "$COMPOSE" \
        --source "$SOURCE" \
        --config "$CONFIG" \
        --name "$OUTPUT" \
        "$@"
}

start_overlay_compose() {
    local log=$1
    shift
    (
        cd "$TEST_ROOT" || exit 1
        exec env \
            PATH="$STUBS:$SYSTEM_PATH" \
            TMPDIR="$TEMP_ROOT" \
            XORRISO_STATE="$STATE" \
            MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 \
            MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
            COMPOSE_TEST_MKSQUASHFS="$OVERLAY_MKS_STUB" \
            COMPOSE_TEST_OVERLAY_PAUSE="${COMPOSE_TEST_OVERLAY_PAUSE:-}" \
            MKSQUASHFS_STATE="${MKSQUASHFS_STATE:-}" \
            MKSQUASHFS_SLEEP="${MKSQUASHFS_SLEEP:-false}" \
            MKSQUASHFS_SLEEP_MARKER="${MKSQUASHFS_SLEEP_MARKER:-}" \
            MKSQUASHFS_STUBBORN="${MKSQUASHFS_STUBBORN:-false}" \
            TOOL_EUID_LOG="$TOOL_EUID_LOG" \
            NO_COLOR=1 \
            "$COMPOSE" --source "$SOURCE" --config "$CONFIG" --name "$OUTPUT" "$@"
    ) >"$log" 2>&1 &
    STARTED_COMPOSE_PID=$!
}

assert_capture_arg_pair() {
    local option=$1
    local expected=$2
    local -a arguments
    local index

    mapfile -d '' -t arguments <"$CAPTURE_STATE/args"
    for index in "${!arguments[@]}"; do
        if [[ ${arguments[$index]} == "$option" ]]; then
            [[ ${arguments[$((index + 1))]} == "$expected" ]]
            return
        fi
    done
    return 1
}

assert_output_contains() {
    [[ $output == *"$1"* ]]
}

assert_build_arg_pair() {
    local option=$1
    local expected=$2
    local -a arguments
    local index

    mapfile -d '' -t arguments <"$STATE/build.args"
    for index in "${!arguments[@]}"; do
        if [[ ${arguments[$index]} == "$option" ]]; then
            [[ ${arguments[$((index + 1))]} == "$expected" ]]
            return
        fi
    done
    return 1
}

@test "explicit source config manifest and volume label reach xorriso" {
    write_file "$SOURCE/config.conf" source-private-configuration
    chmod 000 "$SOURCE/config.conf"
    run_compose --manifest "$MANIFEST" --volume-label "MINIOS LAB" --no-color

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    [[ $output != *'P:customize'* ]]
    [ "$(grep -Fc '/minios/image-customization.json' "$STATE/tree")" -eq 0 ]
    assert_build_arg_pair -volid "MINIOS LAB"
    grep -Fqx '/minios/config.conf' "$STATE/tree"
    grep -Fqx '/minios/build-manifest.json' "$STATE/tree"
    grep -Fqx '/minios/boot/kernel-link' "$STATE/tree"
    grep -Fqx '/minios/boot/empty-directory-link' "$STATE/tree"
    grep -Fqx '/minios/empty target' "$STATE/tree"
    mapfile -d '' -t graft_values <"$STATE/graft-sources"
    config_snapshot=""
    for ((index = 0; index < ${#graft_values[@]}; index += 2)); do
        if [[ ${graft_values[$index]} == minios/config.conf ]]; then
            config_snapshot=${graft_values[$((index + 1))]}
        fi
    done
    [[ $config_snapshot != */input-snapshots/* ]]
    [ "$config_snapshot" -ef "$CONFIG" ]
    [ "$(<"$STATE/config.conf")" = configuration ]
    [ ! -e "$SOURCE/boot/vmlinuz" ]
    [ ! -e "$SOURCE/boot/initrfs.img" ]
    [ "$(<"$SOURCE/boot/syslinux/isolinux.bin")" = isolinux ]
}

@test "long option equals forms parse and an explicit empty name is rejected" {
    equals_output="$OUTPUT_DIR/equals.iso"
    run env PATH="$STUBS:$SYSTEM_PATH" TMPDIR="$TEMP_ROOT" \
        XORRISO_STATE="$STATE" NO_COLOR=1 \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        "$COMPOSE" "--source=$SOURCE" "--config=$CONFIG" \
        "--manifest=$MANIFEST" '--volume-label=MINIOS' \
        "--name=$equals_output"
    [ "$status" -eq 0 ]
    [ -s "$equals_output" ]

    run env PATH="$STUBS:$SYSTEM_PATH" TMPDIR="$TEMP_ROOT" \
        XORRISO_STATE="$STATE" NO_COLOR=1 \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        "$COMPOSE" "--source=$SOURCE" "--config=$CONFIG" '--name='
    [ "$status" -ne 0 ]
    assert_output_contains 'Invalid output filename'
}

@test "an existing source manifest is preserved without an explicit manifest" {
    write_file "$SOURCE/build-manifest.json" '{"from":"source"}'

    run_compose

    [ "$status" -eq 0 ]
    grep -Fqx '/minios/build-manifest.json' "$STATE/tree"
}

@test "top-level source modules do not require an empty modules directory" {
    rmdir "$SOURCE/modules"

    run_compose

    [ "$status" -eq 0 ]
    grep -Fqx '/minios/00-core-amd64.sb' "$STATE/tree"
    grep -Fqx '/minios/01-kernel-amd64.sb' "$STATE/tree"
}

@test "graft argv preserves spaces equals backslashes globs tabs and leading dashes" {
    odd_relative=$'data dir/-odd [x]*=\\name\tfile.txt'
    write_file "$SOURCE/$odd_relative" odd-data
    module="$TEST_ROOT/additional modules/addon.sb"
    write_file "$module" addon

    run_compose "$module"

    [ "$status" -eq 0 ]
    grep -Fqx "/minios/$odd_relative" "$STATE/tree"
    grep -Fqx '/minios/modules/addon.sb' "$STATE/tree"
    [ -e "$STATE/sources.ok" ]
}

@test "source names with newlines fail explicit preflight" {
    newline_path=$'data/new\nline'
    write_file "$SOURCE/$newline_path" unsafe

    run_compose

    [ "$status" -ne 0 ]
    assert_output_contains 'must not contain newline characters'
    [ ! -e "$OUTPUT" ]
}

@test "additional module cannot collide with an included source module" {
    write_file "$SOURCE/modules/addon.sb" source-addon
    module="$TEST_ROOT/other/addon.sb"
    write_file "$module" other-addon

    run_compose "$module"

    [ "$status" -ne 0 ]
    assert_output_contains 'destination collides'
    [ ! -e "$OUTPUT" ]
}

@test "flattened source module basenames are unique for no-custom overlay and capture builds" {
    write_file "$SOURCE/duplicate.sb" top-level
    write_file "$SOURCE/modules/duplicate.sb" modules-directory
    overlay="$TEST_ROOT/duplicate overlay"
    mkdir "$overlay"
    write_file "$overlay/value" overlay

    run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'Duplicate module basename after runtime flattening'
    [ ! -e "$OUTPUT" ]

    pushd "$TEST_ROOT" >/dev/null
    run_compose --overlay-directory "$overlay"
    popd >/dev/null
    [ "$status" -ne 0 ]
    assert_output_contains 'Duplicate module basename after runtime flattening'
    [ ! -e "$OUTPUT" ]

    run_compose --capture-changes exact
    [ "$status" -ne 0 ]
    assert_output_contains 'Duplicate module basename after runtime flattening'
    [ ! -e "$OUTPUT" ]
}

@test "invalid additional SquashFS is rejected with diagnostics" {
    module="$TEST_ROOT/modules/invalid.sb"
    write_file "$module" invalid

    run_compose "$module"

    [ "$status" -eq 3 ]
    assert_output_contains 'invalid SquashFS image'
    assert_output_contains 'not valid SquashFS'
    [ ! -e "$OUTPUT" ]
}

@test "existing output is preserved unless overwrite is explicit" {
    write_file "$OUTPUT" original-output

    run_compose
    [ "$status" -ne 0 ]
    [ "$(<"$OUTPUT")" = original-output ]

    run_compose --overwrite
    [ "$status" -eq 0 ]
    [ "$(<"$OUTPUT")" = 'partial ISO' ]
}

@test "required boot module config and manifest exclusions fail preflight" {
    local pattern
    local expected
    local -a patterns=(
        '^boot/vmlinuz'
        '^00-core'
        '(^|/)config[.]conf$'
        'build-manifest[.]json$'
    )
    local -a messages=(
        'excluded path'
        'required source module'
        'minios/config.conf'
        'minios/build-manifest.json'
    )

    for index in "${!patterns[@]}"; do
        pattern=${patterns[$index]}
        expected=${messages[$index]}
        run_compose --manifest "$MANIFEST" --exclude "$pattern"
        [ "$status" -ne 0 ]
        assert_output_contains "$expected"
        [ ! -e "$OUTPUT" ]
    done
}

@test "source symlink chains reject an excluded immediate component" {
    mkdir -p "$SOURCE/links"
    write_file "$SOURCE/links/final" final
    ln -s final "$SOURCE/links/intermediate"
    ln -s intermediate "$SOURCE/links/top"

    run_compose --exclude '^links/intermediate$'

    [ "$status" -ne 0 ]
    assert_output_contains 'chain contains an excluded path'
    [ ! -e "$OUTPUT" ]
}

@test "configuration and source arguments reject final symlinks" {
    config_link="$TEST_ROOT/config-link.conf"
    source_link="$TEST_ROOT/source-link"
    ln -s "$CONFIG" "$config_link"
    ln -s "$SOURCE" "$source_link"

    run env PATH="$STUBS:$SYSTEM_PATH" XORRISO_STATE="$STATE" TMPDIR="$TEMP_ROOT" \
        "$COMPOSE" --source "$SOURCE" --config "$config_link" --name "$OUTPUT"
    [ "$status" -ne 0 ]
    assert_output_contains 'must not be a symbolic link'

    run env PATH="$STUBS:$SYSTEM_PATH" XORRISO_STATE="$STATE" TMPDIR="$TEMP_ROOT" \
        "$COMPOSE" --source "$source_link" --config "$CONFIG" --name "$OUTPUT"
    [ "$status" -eq 2 ]
    assert_output_contains 'must not be a symbolic link'
}

@test "invalid labels and invalid JSON manifests fail before output work" {
    run_compose --volume-label $'BAD\nLABEL'
    [ "$status" -ne 0 ]
    assert_output_contains 'printable ASCII'

    write_file "$MANIFEST" '{not-json'
    run_compose --manifest "$MANIFEST"
    [ "$status" -ne 0 ]
    assert_output_contains 'Manifest is not valid JSON'
    [ ! -e "$OUTPUT" ]
}

@test "isolated adapter helpers ignore malicious Python modules in the working directory" {
    poison="$TEST_ROOT/poison modules"
    marker="$TEST_ROOT/poison-executed"
    mkdir -p "$poison"
    for module in ctypes hashlib json; do
        printf 'open("%s", "a").write("%s\\n")\n' "$marker" "$module" >"$poison/$module.py"
    done

    original_directory=$PWD
    cd "$poison"
    run_compose
    cd "$original_directory"

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    [ ! -e "$marker" ]
}

@test "writer and structural verification failures remove the exact target" {
    MKFS_EXT2_FAIL=true run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'requested failure'
    assert_output_contains 'Failed to format persistence image'
    [ ! -e "$OUTPUT" ]

    MKFS_EXT2_FAIL=false
    XORRISO_BUILD_MODE=fail run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'requested write failure'
    [ ! -e "$OUTPUT" ]

    XORRISO_BUILD_MODE=success
    XORRISO_OMIT_DEST=minios/config.conf run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'missing grafted path: minios/config.conf'
    [ ! -e "$OUTPUT" ]
}

@test "input and output identity races fail without overwriting attacker paths" {
    config_parent=${CONFIG%/*}
    input_victim="$TEST_ROOT/input ancestor victim"
    write_file "$input_victim/live config.conf" attacker-config

    XORRISO_RACE_INPUT_PARENT="$config_parent" \
        XORRISO_RACE_INPUT_VICTIM="$input_victim" run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'changed during ISO creation'
    [ ! -e "$OUTPUT" ]
    [ "$(<"$STATE/config.conf")" = configuration ]
    rm -- "$config_parent"
    mv -- "$config_parent.moved" "$config_parent"

    XORRISO_RACE_INPUT="$CONFIG" run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'changed during ISO creation'
    [ ! -e "$OUTPUT" ]
    [ "$(<"$STATE/config.conf")" = configuration ]
    write_file "$CONFIG" configuration

    XORRISO_RACE_OUTPUT_TARGET="$OUTPUT" run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'output path identity changed'
    [ "$(<"$OUTPUT")" = 'attacker output' ]
    rm -- "$OUTPUT"

    output_victim="$TEST_ROOT/output ancestor victim"
    mkdir -p "$output_victim"
    write_file "$output_victim/sentinel" untouched
    XORRISO_RACE_OUTPUT_PARENT="$OUTPUT_DIR" \
        XORRISO_RACE_OUTPUT_VICTIM="$output_victim" run_compose
    [ "$status" -ne 0 ]
    assert_output_contains 'output path identity changed'
    [ "$(<"$output_victim/sentinel")" = untouched ]
    [ ! -e "$output_victim/image partial.iso" ]
    [ ! -e "$OUTPUT_DIR.moved/image partial.iso" ]
    shopt -s nullglob
    private_outputs=("$OUTPUT_DIR.moved"/.minios-image-compose-output.*)
    [ "${#private_outputs[@]}" -eq 0 ]
}

@test "successful output includes stable phase IDs" {
    run_compose

    [ "$status" -eq 0 ]
    for phase_id in prepare boot-copy persistence iso-write verify complete; do
        assert_output_contains "P:$phase_id"
    done
    [[ $output != *$'\e['* ]]
}

@test "capture option combinations validate before build work" {
    run_compose --capture-changes selected
    [ "$status" -ne 0 ]
    assert_output_contains 'requires --capture-selection'

    write_file "$SESSION_SELECTION" '{"product_kind":"minios-session-selection","schema_version":1,"include_paths":[],"exclude_paths":[]}'
    run_compose --capture-changes clean --capture-selection "$SESSION_SELECTION"
    [ "$status" -ne 0 ]
    assert_output_contains 'only valid with --capture-changes selected'

    run_compose --capture-compression xz
    [ "$status" -ne 0 ]
    assert_output_contains 'requires --capture-changes'

    run_compose --capture-changes=unsafe
    [ "$status" -ne 0 ]
    assert_output_contains 'Invalid session capture mode'

    run_compose --capture-changes=
    [ "$status" -ne 0 ]
    assert_output_contains 'Invalid session capture mode'

    run_compose --capture-changes clean --capture-compression=unsafe
    [ "$status" -ne 0 ]
    assert_output_contains 'Invalid session capture compression'
    [ ! -e "$OUTPUT" ]
}

