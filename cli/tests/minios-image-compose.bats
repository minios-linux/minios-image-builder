}

@test "image customization options reject unsafe and out-of-range values" {
    local value
    for value in -1 301 1.5 ''; do
        run_compose "--boot-timeout=$value"
        [ "$status" -ne 0 ]
        assert_output_contains 'Boot timeout must be an integer from 0 to 300'
        [ ! -e "$OUTPUT" ]
    done

    run_compose --default-boot translated-label
    [ "$status" -ne 0 ]
    assert_output_contains 'Invalid default boot mode'

    for value in $'quiet\tdebug' $'quiet\ndebug' "name=\$unsafe" 'foo="bar"'; do
        run_compose --kernel-args "$value"
        [ "$status" -ne 0 ]
        [[ $output != *"$value"* ]]
        [ ! -e "$OUTPUT" ]
    done

    oversized=$(printf 'a%.0s' {1..4097})
    run_compose --kernel-args "$oversized"
    [ "$status" -ne 0 ]
    assert_output_contains 'exceed 4096'
    [ ! -e "$OUTPUT" ]

    run_compose --overlay-directory "$TEST_ROOT"
    [ "$status" -ne 0 ]
    assert_output_contains 'must not contain the MiniOS source tree'

    run_compose --overlay-directory ./relative-overlay
    [ "$status" -ne 0 ]
    assert_output_contains 'must be an absolute path'
}

