}

@test "boot background rejects symlink invalid dimensions oversized and tampered PNG data" {
    invalid="$TEST_ROOT/not-a-png.png"
    write_file "$invalid" invalid
    run_compose --boot-background "$invalid"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    dimensions="$TEST_ROOT/invalid dimensions.png"
    create_test_png "$dimensions" 9000 600
    run_compose --boot-background "$dimensions"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    oversized="$TEST_ROOT/oversized.png"
    create_test_png "$oversized"
    truncate -s 16777217 "$oversized"
    run_compose --boot-background "$oversized"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    valid="$TEST_ROOT/valid.png"
    create_test_png "$valid"

    bad_crc="$TEST_ROOT/bad crc.png"
    cp "$valid" "$bad_crc"
    python3 -c 'import sys
path = sys.argv[1]
data = bytearray(open(path, "rb").read())
data[-1] ^= 1
open(path, "wb").write(data)' "$bad_crc"
    run_compose --boot-background "$bad_crc"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    trailing="$TEST_ROOT/trailing.png"
    cp "$valid" "$trailing"
    printf unsafe >>"$trailing"
    run_compose --boot-background "$trailing"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    truncated="$TEST_ROOT/truncated.png"
    cp "$valid" "$truncated"
    truncate -s -12 "$truncated"
    run_compose --boot-background "$truncated"
    [ "$status" -ne 0 ]
    assert_output_contains 'not a supported PNG'

    ln -s "$valid" "$TEST_ROOT/background-link.png"
    run_compose --boot-background "$TEST_ROOT/background-link.png"
    [ "$status" -ne 0 ]
    assert_output_contains 'must not be a symbolic link'

    XORRISO_TAMPER_EXTRACT=/minios/boot/bootlogo791.png \
        run_compose --boot-background "$valid"
    [ "$status" -ne 0 ]
    assert_output_contains 'customization bytes or digest report failed verification'
    [ ! -e "$OUTPUT" ]
}

@test "project overlay snapshots safe files and emits a verified dynamic report" {
    overlay="$TEST_ROOT/project overlay"
    mks_state="$TEST_ROOT/overlay mks state"
    mkdir -p "$overlay/etc" "$overlay/usr/bin" "$overlay/empty"
    write_file "$overlay/etc/application.conf" configured
    write_file "$overlay/usr/bin/image-tool" executable
    chmod 0755 "$overlay/usr/bin/image-tool"
    ln -s ../usr/bin/image-tool "$overlay/etc/tool-link"
    write_file "$SOURCE/image-customization.json" '{"attacker":true}'

    pushd "$TEST_ROOT" >/dev/null
    MKSQUASHFS_STATE="$mks_state" run_compose --overlay-directory "$overlay"
    popd >/dev/null

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    assert_output_contains 'P:customize'
    [ "$(<"$STATE/image-overlay.destination")" = minios/02-image-overlay.sb ]
    [ "$(<"$mks_state/tree/etc/application.conf")" = configured ]
    [ "$(<"$mks_state/tree/usr/bin/image-tool")" = executable ]
    [ "$(readlink "$mks_state/tree/etc/tool-link")" = ../usr/bin/image-tool ]
    grep -q '^mksquashfs:' "$TOOL_EUID_LOG"

    run python3 -c '
import json, sys
report = json.load(open(sys.argv[1], encoding="utf-8"))
assert report["product_kind"] == "minios-image-customization"
assert report["schema_version"] == 1
assert report["boot"] == {"background": None, "configs": [], "default_boot": None,
                           "kernel_args": None, "timeout_seconds": None}
overlay = report["overlay"]
assert overlay["target"] == "minios/02-image-overlay.sb"
assert overlay["module_order"] == 2
assert overlay["size"] > 0
assert len(overlay["sha256"]) == 64
assert len(overlay["input_tree_fingerprint"]) == 64
assert overlay["entry_count"] == 8
' "$STATE/image-customization.json"
    [ "$status" -eq 0 ]
    [[ $(<"$STATE/image-customization.json") != *attacker* ]]
}

