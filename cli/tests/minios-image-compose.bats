@test "boot customization follows multilingual session configs and ignores translated labels" {
    prepare_custom_boot_fixture
    background="$TEST_ROOT/custom background.png"
    create_test_png "$background" 1024 768
    cp "$background" "$SOURCE/boot/bootlogo788.png"
    kernel_text='audit=1 customization_token=redacted'
    expected_kernel_hash=$(printf '%s' "$kernel_text" | sha256sum)
    expected_kernel_hash=${expected_kernel_hash%% *}

    run_compose --boot-timeout=7 --default-boot choose \
        --kernel-args "$kernel_text" --boot-background "$background"

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    assert_output_contains 'P:customize'
    [[ $output != *"$kernel_text"* ]]
    [[ $(<"$STATE/files/minios/boot/grub/grub.cfg") == *'set timeout=7'* ]]
    [[ $(<"$STATE/files/minios/boot/grub/grub.cfg") == *'set default=0'* ]]
    grep -Fqx 'set default=2' "$STATE/files/minios/boot/grub/main.cfg"
    grep -Fqx 'set timeout=7' "$STATE/files/minios/boot/grub/main.cfg"
    [ "$(grep -Fc " $kernel_text" "$STATE/files/minios/boot/grub/main.cfg")" -eq 5 ]
    grep -Fqx 'TIMEOUT 70' "$STATE/files/minios/boot/syslinux/syslinux.cfg"
    [ "$(grep -Ec '^DEFAULT ' "$STATE/files/minios/boot/syslinux/syslinux.cfg")" -eq 0 ]
    for language in en_US ru_RU; do
        config="$STATE/files/minios/boot/syslinux/lang/$language.cfg"
        grep -Fqx 'DEFAULT asksession' "$config"
        grep -Fqx 'ONTIMEOUT asksession' "$config"
        [ "$(grep -Fc 'MENU DEFAULT' "$config")" -eq 0 ]
        grep -Fqx 'TIMEOUT 70' "$config"
        [ "$(grep -Fc " $kernel_text" "$config")" -eq 5 ]
    done
    cmp -s "$background" "$STATE/files/minios/boot/bootlogo788.png"
    cmp -s "$background" "$STATE/files/minios/boot/bootlogo791.png"
    [[ $(<"$SOURCE/boot/grub/main.cfg") != *"$kernel_text"* ]]

    run python3 -c '
import json, sys
report = json.load(open(sys.argv[1], encoding="utf-8"))
assert report["product_kind"] == "minios-image-customization"
assert report["schema_version"] == 1
assert report["boot"]["timeout_seconds"] == 7
assert report["boot"]["default_boot"] == "choose"
assert report["boot"]["kernel_args"] == {"bytes": len(sys.argv[2].encode()), "sha256": sys.argv[3]}
assert len(report["boot"]["configs"]) == 5
assert report["boot"]["background"]["width"] == 1024
assert report["boot"]["background"]["height"] == 768
assert set(report["boot"]["background"]["targets"]) == {
    "minios/boot/bootlogo788.png", "minios/boot/bootlogo791.png"}
assert report["overlay"] is None
assert sys.argv[2] not in open(sys.argv[1], encoding="utf-8").read()
' "$STATE/image-customization.json" "$kernel_text" "$expected_kernel_hash"
    [ "$status" -eq 0 ]
}

@test "localized generated GRUB config receives semantic default and timeout customization" {
