@test "MiniOS SYSLINUX-GRUB chainloader delegates session customization to GRUB" {
    prepare_syslinux_grub_fixture
    kernel_text='audit=1 chainloader=verified'

    run_compose --boot-timeout 4 --default-boot fresh --kernel-args "$kernel_text"

    [ "$status" -eq 0 ]
    grep -Fqx 'set timeout=4' "$STATE/files/minios/boot/grub/main.cfg"
    grep -Fqx 'set default=3' "$STATE/files/minios/boot/grub/main.cfg"
    [ "$(grep -Fc " $kernel_text" "$STATE/files/minios/boot/grub/main.cfg")" -eq 5 ]
    grep -Fqx 'TIMEOUT 1' "$STATE/files/minios/boot/syslinux/syslinux.cfg"
    grep -Fqx 'LINUX /minios/boot/grub/i386-pc/lnxboot.img' \
        "$STATE/files/minios/boot/syslinux/syslinux.cfg"
    [ "$(grep -Fc "$kernel_text" "$STATE/files/minios/boot/syslinux/syslinux.cfg")" -eq 0 ]
    run python3 -c '
import json, sys
report = json.load(open(sys.argv[1], encoding="utf-8"))
assert {item["target"] for item in report["boot"]["configs"]} == {
    "minios/boot/grub/grub.cfg", "minios/boot/grub/main.cfg"}
' "$STATE/image-customization.json"
    [ "$status" -eq 0 ]
}

@test "MiniOS SYSLINUX-GRUB chainloader rejects every extra boot directive" {
    prepare_syslinux_grub_fixture
    chainloader=$(<"$SOURCE/boot/syslinux/syslinux.cfg")
    local directive
    local -a directives=(
        'COM32 menu.c32'
        'LOCALBOOT 0'
        'BOOT /minios/boot/vmlinuz-test'
        'KERNEL /minios/boot/vmlinuz-test'
        'APPEND boot=live'
        'LINUX /minios/boot/vmlinuz-test'
        'INITRD /minios/boot/initrfs-test.img'
    )

    for directive in "${directives[@]}"; do
        printf '%s\n%s\n' "$chainloader" "$directive" >"$SOURCE/boot/syslinux/syslinux.cfg"
        run_compose --boot-timeout 4
        [ "$status" -ne 0 ]
        assert_output_contains 'not a provable GRUB chainloader'
        [ ! -e "$OUTPUT" ]
    done
}

@test "native SYSLINUX without a provable session menu remains ambiguous" {
