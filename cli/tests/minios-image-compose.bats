@test "capture elevates only savechanges and keeps ISO phases at the caller EUID" {
    run_compose --capture-changes clean

    [ "$status" -eq 0 ]
    mapfile -d '' -t elevated_arguments <"$PKEXEC_STATE/args"
    [ "${elevated_arguments[0]}" = "$CAPTURE_STUB" ]
    [ "$(<"$PKEXEC_STATE/euid")" -eq "$EUID" ]
    while IFS= read -r observed_euid; do
        [ "$observed_euid" -eq "$EUID" ]
    done <"$STATE/euids"
    while IFS=: read -r _tool observed_euid; do
        [ "$observed_euid" -eq "$EUID" ]
    done <"$TOOL_EUID_LOG"
    assert_output_contains 'P:persistence'
    assert_output_contains 'P:iso-write'
    assert_output_contains 'P:verify'
}

@test "selected capture is hashed reported grafted top-level and phase-transparent" {
    selection_secret='home/private-selection-marker-do-not-log'
    write_file "$SESSION_SELECTION" "{\"product_kind\":\"minios-session-selection\",\"schema_version\":1,\"include_paths\":[\"$selection_secret\"],\"exclude_paths\":[]}"
    expected_selection_hash=$(sha256sum "$SESSION_SELECTION")
    expected_selection_hash=${expected_selection_hash%% *}

    run_compose --manifest "$MANIFEST" --capture-changes=selected \
        --capture-selection="$SESSION_SELECTION" --capture-compression=xz

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    assert_output_contains 'P:capture'
    for phase_id in capture-inventory capture-copy capture-compress capture-complete; do
        assert_output_contains "P:$phase_id"
    done
    assert_output_contains 'Session capture module target: minios/02-session-changes.sb'
    assert_output_contains 'Session capture union backend: overlayfs'
    assert_output_contains 'Session capture module order: 2'
    assert_output_contains 'Session capture module SHA256:'
    [[ $output != *"$selection_secret"* ]]
    grep -Fqx '/minios/02-session-changes.sb' "$STATE/tree"
    grep -Fqx '/minios/session-capture.json' "$STATE/tree"
    [ "$(<"$STATE/session-capture.size")" -gt 0 ]
    assert_capture_arg_pair --profile selected
    assert_capture_arg_pair --comp xz

    mapfile -d '' -t capture_arguments <"$CAPTURE_STATE/args"
    [[ ${capture_arguments[${#capture_arguments[@]}-1]} == */02-session-changes.sb ]]
    selection_copy=""
    capture_work_parent=""
    for index in "${!capture_arguments[@]}"; do
        if [[ ${capture_arguments[$index]} == --selection ]]; then
            selection_copy=${capture_arguments[$((index + 1))]}
        elif [[ ${capture_arguments[$index]} == --work-parent ]]; then
            capture_work_parent=${capture_arguments[$((index + 1))]}
        fi
    done
    [[ $selection_copy == */session-selection.json ]]
    [ -n "$capture_work_parent" ]
    [ "${capture_arguments[${#capture_arguments[@]}-1]%/*}" = "$capture_work_parent" ]

    run python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)
assert value["product_kind"] == "minios-session-capture-report"
assert value["schema_version"] == 3
assert value["profile"] == "selected"
assert value["union_backend"] == "overlayfs"
assert value["boot_id"] == "11111111-2222-3333-4444-555555555555"
assert len(value["base_module_fingerprint"]) == 64
assert value["module_order"] == 2
assert value["module"]["target"] == "minios/02-session-changes.sb"
assert value["module"]["size"] > 0
assert len(value["module"]["sha256"]) == 64
assert value["selection_sha256"] == sys.argv[2]
' "$STATE/session-capture.json" "$expected_selection_hash"
    [ "$status" -eq 0 ]
    [[ $(<"$STATE/session-capture.json") != *"$selection_secret"* ]]
    [ "$(<"$MANIFEST")" = '{"schema_version":1}' ]
}

@test "explicit capture source requires and validates running base module binding" {
    SAVECHANGES_STUB_BASE_FINGERPRINT=$(printf '%064d' 1) run_compose --capture-changes exact
    [ "$status" -ne 0 ]
    assert_output_contains 'running base modules do not match the ISO source'
    [ ! -e "$OUTPUT" ]

    SAVECHANGES_STUB_BASE_FINGERPRINT=none run_compose --capture-changes exact
    [ "$status" -ne 0 ]
    assert_output_contains 'explicit ISO source cannot be bound'
    [ ! -e "$OUTPUT" ]
}

@test "capture rejects malformed additive sizing footprint and required identity metadata" {
    local metadata_mode
    local -a metadata_modes=(
        module-size module-digest entry-count-type uncompressed-size-type
        footprint-schema-type footprint-size footprint-field
    )
    for metadata_mode in "${metadata_modes[@]}"; do
        SAVECHANGES_STUB_METADATA_MODE=$metadata_mode \
            run_compose --capture-changes exact
        [ "$status" -ne 0 ]
        assert_output_contains 'Cannot validate privileged capture metadata or create report'
        [ ! -e "$OUTPUT" ]
    done
}

@test "capture order is dynamic and sorts after 10 99 and 100-plus modules" {
    write_file "$SOURCE/10-application.sb" ten
    write_file "$SOURCE/99-late.sb" ninety-nine
    write_file "$SOURCE/modules/100-extra.sb" one-hundred
    run_compose --capture-changes exact
    [ "$status" -eq 0 ]
    grep -Fqx '/minios/101-session-changes.sb' "$STATE/tree"
    [ "$(<"$STATE/session-capture.destination")" = minios/101-session-changes.sb ]
    run python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    report = json.load(stream)
assert report["module_order"] == 101
assert report["module"]["target"] == "minios/101-session-changes.sb"
' "$STATE/session-capture.json"
    [ "$status" -eq 0 ]

    rm "$OUTPUT"
    write_file "$SOURCE/999999-blocker.sb" blocker
    run_compose --capture-changes exact
    [ "$status" -eq 3 ]
    assert_output_contains 'No safe numeric order remains'
}

@test "invalid capture output and missing ISO capture graft fail closed" {
