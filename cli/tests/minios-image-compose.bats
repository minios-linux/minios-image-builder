@test "real savechanges and SquashFS tools flow through capture report and extraction" {
    real_mksquashfs=$(PATH="$SYSTEM_PATH" command -v mksquashfs) ||
        skip 'mksquashfs is not installed'
    real_unsquashfs=$(PATH="$SYSTEM_PATH" command -v unsquashfs) ||
        skip 'unsquashfs is not installed'
    capture_tools="$TEST_ROOT/real capture tools"
    capture_source="$TEST_ROOT/real savechanges source"
    changes="$TEST_ROOT/real writable changes"
    mkdir -p "$capture_tools" "$capture_source/bin" "$capture_source/lib" \
        "$capture_source/tests"
    write_file "$changes/etc/default/integrated-value" integrated-capture
    CAPTURE_STUB="$capture_source/bin/savechanges"
    real_savechanges="${COMPOSE_REAL_SAVECHANGES:-}"
    [ -n "$real_savechanges" ] ||
        real_savechanges=$(PATH="$SYSTEM_PATH" command -v savechanges 2>/dev/null) ||
        true
    [ -n "$real_savechanges" ] && [ -f "$real_savechanges" ] ||
        real_savechanges="$BATS_TEST_DIRNAME/../../../minios-tools/bin/savechanges"
    [ -f "$real_savechanges" ] || skip 'savechanges is not available'
    cp -- "$real_savechanges" "$CAPTURE_STUB"
    real_savechanges_engine="${real_savechanges%/*}/../lib/minios_savechanges_engine.py"
    if [ -f "$real_savechanges_engine" ]; then
        cp -- "$real_savechanges_engine" \
            "$capture_source/lib/minios_savechanges_engine.py"
    fi
    cp -- "$BATS_TEST_DIRNAME/.source-test-context" "$capture_source/tests/.source-test-context"
    cp -- "$real_mksquashfs" "$capture_tools/mksquashfs"
    cp -- "$real_unsquashfs" "$capture_tools/unsquashfs"
    chmod 0755 "$CAPTURE_STUB" "$capture_tools/mksquashfs" "$capture_tools/unsquashfs"
    capture_mountinfo="$TEST_ROOT/real capture mountinfo"
    capture_cmdline="$TEST_ROOT/real capture cmdline"
    capture_boot_id="$TEST_ROOT/real capture boot-id"
    escaped_changes=${changes// /\\040}
    printf '24 1 0:1 / / rw - overlay overlay rw,lowerdir=/lower/01-kernel-amd64.sb:/lower/00-core-amd64.sb,upperdir=%s,workdir=/work\n' \
        "$escaped_changes" >"$capture_mountinfo"
    printf '%s\n' 'BOOT_IMAGE=/minios/boot/vmlinuz union=aufs' >"$capture_cmdline"
    printf '%s\n' '11111111-2222-3333-4444-555555555555' >"$capture_boot_id"

    COMPOSE_TEST_CHANGES_ROOT="$changes" \
        MINIOS_TOOLS_TEST_MKSQUASHFS="$capture_tools/mksquashfs" \
        MINIOS_TOOLS_TEST_UNSQUASHFS="$capture_tools/unsquashfs" \
        MINIOS_TOOLS_TEST_MOUNTINFO="$capture_mountinfo" \
        MINIOS_TOOLS_TEST_CMDLINE="$capture_cmdline" \
        MINIOS_TOOLS_TEST_BOOT_ID="$capture_boot_id" \
        MINIOS_TOOLS_TEST_RUNNING_SOURCE="$SOURCE" \
        run_compose --capture-changes exact

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    [ -s "$STATE/session-capture.sb" ]
    extracted="$TEST_ROOT/extracted capture"
    run "$real_unsquashfs" -d "$extracted" "$STATE/session-capture.sb"
    [ "$status" -eq 0 ]
    [ "$(<"$extracted/etc/default/integrated-value")" = integrated-capture ]
}

@test "real mksquashfs conditionally creates a readable rootless image overlay" {
    real_mksquashfs=$(PATH="$SYSTEM_PATH" command -v mksquashfs) ||
        skip 'mksquashfs is not installed'
    real_unsquashfs=$(PATH="$SYSTEM_PATH" command -v unsquashfs) ||
        skip 'unsquashfs is not installed'
    cp -- "$real_mksquashfs" "$OVERLAY_MKS_STUB"
    chmod 0755 "$OVERLAY_MKS_STUB"
    overlay="$TEST_ROOT/real overlay"
    mkdir -p "$overlay/etc" "$overlay/usr/bin"
    write_file "$overlay/etc/real.conf" real-overlay
    write_file "$overlay/usr/bin/real-tool" executable
    chmod 0755 "$overlay/usr/bin/real-tool"
    chmod 0644 "$overlay/etc/real.conf"
    ln -s ../usr/bin/real-tool "$overlay/etc/real-tool-link"
    touch -d '@1700000100' "$overlay/etc/real.conf" "$overlay/usr/bin/real-tool"
    expected_config_hash=$(sha256sum "$overlay/etc/real.conf")
    expected_config_hash=${expected_config_hash%% *}

    pushd "$TEST_ROOT" >/dev/null
    run_compose --overlay-directory "$overlay"
    popd >/dev/null

    [ "$status" -eq 0 ]
    [ -s "$STATE/image-overlay.sb" ]
    run "$real_unsquashfs" -s "$STATE/image-overlay.sb"
    [ "$status" -eq 0 ]
    extracted="$TEST_ROOT/real overlay extracted"
    run "$real_unsquashfs" -d "$extracted" "$STATE/image-overlay.sb"
    [ "$status" -eq 0 ]
    [ "$(<"$extracted/etc/real.conf")" = real-overlay ]
    [ "$(stat -c '%a' "$extracted/etc/real.conf")" = 644 ]
    [ -x "$extracted/usr/bin/real-tool" ]
    [ "$(stat -c '%a' "$extracted/usr/bin/real-tool")" = 755 ]
    [ "$(stat -c '%Y' "$extracted/etc/real.conf")" = 1700000100 ]
    [ -L "$extracted/etc/real-tool-link" ]
    [ "$(readlink "$extracted/etc/real-tool-link")" = ../usr/bin/real-tool ]
    extracted_config_hash=$(sha256sum "$extracted/etc/real.conf")
    [ "${extracted_config_hash%% *}" = "$expected_config_hash" ]
}

@test "nested cancellation marker stops a root capture helper across the UID boundary" {
    (( EUID != 0 )) || skip 'requires an unprivileged minios-image-compose parent'
    [[ -x /usr/bin/sudo ]] || skip 'sudo is unavailable'
    /usr/bin/sudo -n true >/dev/null 2>&1 || skip 'passwordless sudo is unavailable'
    log="$TEST_ROOT/root-capture-cancel.log"

    set +e
    env \
        PATH="$STUBS:$SYSTEM_PATH" \
        TMPDIR="$TEMP_ROOT" \
        XORRISO_STATE="$STATE" \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 \
        MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        COMPOSE_TEST_SAVECHANGES="$CAPTURE_STUB" \
        COMPOSE_TEST_PKEXEC="$PKEXEC_STUB" \
        PKEXEC_STUB_STATE="$PKEXEC_STATE" \
        PKEXEC_STUB_ROOT=true \
        SAVECHANGES_STUB_STATE="$CAPTURE_STATE" \
        SAVECHANGES_STUB_MODE=root-stubborn \
        SAVECHANGES_STUB_SOURCE="$SOURCE" \
        NO_COLOR=1 \
        "$COMPOSE" --source "$SOURCE" --config "$CONFIG" --name "$OUTPUT" \
        --capture-changes clean >"$log" 2>&1 &
    script_pid=$!
    for _ in {1..500}; do
        [[ -e $CAPTURE_STATE/root.started ]] && break
        sleep 0.02
    done
    [ -e "$CAPTURE_STATE/root.started" ]
    mapfile -t root_pids <"$CAPTURE_STATE/root.started"
    [ "${#root_pids[@]}" -eq 2 ]
    [ "$(stat -c '%u' "/proc/${root_pids[0]}")" -eq 0 ]
    if kill -TERM "${root_pids[0]}" 2>/dev/null; then
        false
    fi

    mapfile -d '' -t capture_arguments <"$CAPTURE_STATE/args"
    cancel_file=""
    for index in "${!capture_arguments[@]}"; do
        if [[ ${capture_arguments[$index]} == --cancel-file ]]; then
            cancel_file=${capture_arguments[$((index + 1))]}
        fi
    done
    [[ $cancel_file == "$TEMP_ROOT"/minios-image-compose.*/capture.cancel ]]
    [ "$(stat -c '%a' "${cancel_file%/*}")" = 700 ]
    [ "$(stat -c '%u' "${cancel_file%/*}")" -eq "$EUID" ]
    [ ! -e "$cancel_file" ]

    kill -TERM "$script_pid"
    result=0
    wait "$script_pid" || result=$?
    set -e

    [ "$result" -eq 130 ]
    grep -Fqx 'P:cancelled' "$log"
    [[ $(<"$log") != *"$cancel_file"* ]]
    for root_pid in "${root_pids[@]}"; do
        assert_process_gone "$root_pid"
    done
    [ ! -e "$OUTPUT" ]
    [ ! -e "$cancel_file" ]
    shopt -s nullglob dotglob
    leftovers=("$TEMP_ROOT"/*)
    [ "${#leftovers[@]}" -eq 0 ]
}

@test "TERM escalates for a stubborn writer and cleanup exits 130 without partial files" {
    log="$TEST_ROOT/signal.log"
    set +e
    env \
        PATH="$STUBS:$SYSTEM_PATH" \
        TMPDIR="$TEMP_ROOT" \
        XORRISO_STATE="$STATE" \
        XORRISO_BUILD_MODE=stubborn \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 \
        MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        NO_COLOR=1 \
        "$COMPOSE" --source "$SOURCE" --config "$CONFIG" --name "$OUTPUT" \
        >"$log" 2>&1 &
    script_pid=$!
    for _ in {1..100}; do
        [[ -e $STATE/build.started ]] && break
        sleep 0.05
    done
    [ -e "$STATE/build.started" ]
    mapfile -t child_pids <"$STATE/build.started"
    [ "${#child_pids[@]}" -eq 2 ]
    shopt -s nullglob
    active_temp_dirs=("$TEMP_ROOT"/minios-image-compose.*)
    [ "${#active_temp_dirs[@]}" -eq 1 ]
    [ "$(stat -c '%a' "${active_temp_dirs[0]}")" = 700 ]
    kill -TERM "$script_pid"
    wait "$script_pid"
    result=$?
    set -e

    [ "$result" -eq 130 ]
    for child_pid in "${child_pids[@]}"; do
        assert_process_gone "$child_pid"
    done
    [ ! -e "$OUTPUT" ]
    shopt -s nullglob dotglob
    leftovers=("$TEMP_ROOT"/*)
    [ "${#leftovers[@]}" -eq 0 ]
}

@test "a writer leader exit cannot orphan its process group" {
    XORRISO_BUILD_MODE=leader-exit run_compose

    [ "$status" -ne 0 ]
    assert_output_contains 'descendant processes remained'
    mapfile -t child_pids <"$STATE/build.started"
    [ "${#child_pids[@]}" -eq 2 ]
    for child_pid in "${child_pids[@]}"; do
        assert_process_gone "$child_pid"
    done
    [ ! -e "$OUTPUT" ]
    shopt -s nullglob dotglob
    leftovers=("$TEMP_ROOT"/*)
    [ "${#leftovers[@]}" -eq 0 ]
}

@test "routine real no-custom ISO preserves source metadata and extracted Rock Ridge modes" {
    (( EUID != 0 )) || skip 'rootless metadata integration requires an unprivileged caller'
    prepare_real_iso_fixture
    source_before=$(stat -c '%a:%Y:%d:%i:%h' \
        "$SOURCE/metadata/executable" "$SOURCE/metadata/plain" \
        "$SOURCE/metadata/plain-link" "$SOURCE/metadata/large.bin")
    source_hash_before=$(sha256sum "$SOURCE/metadata/executable" "$SOURCE/metadata/plain" \
        "$SOURCE/metadata/large.bin")

    run env PATH="$REAL_XORRISO_TOOLS:$SYSTEM_PATH" TMPDIR="$TEMP_ROOT" \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        REAL_XORRISO="$REAL_XORRISO" REAL_XORRISO_STATE="$REAL_XORRISO_STATE" \
        REAL_XORRISO_SOURCE_FILE="$SOURCE/metadata/large.bin" \
        LC_ALL=C.UTF-8 LANG=C.UTF-8 NO_COLOR=1 \
        "$COMPOSE" --source "$SOURCE" --config "$CONFIG" --name "$OUTPUT"

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    [ -e "$REAL_XORRISO_STATE/snapshot-inplace" ]
    [ "$(stat -c '%a:%Y:%d:%i:%h' \
        "$SOURCE/metadata/executable" "$SOURCE/metadata/plain" \
        "$SOURCE/metadata/plain-link" "$SOURCE/metadata/large.bin")" = "$source_before" ]
    [ "$(sha256sum "$SOURCE/metadata/executable" "$SOURCE/metadata/plain" \
        "$SOURCE/metadata/large.bin")" = "$source_hash_before" ]

    extracted="$TEST_ROOT/real extracted metadata"
    run "$REAL_XORRISO" -no_rc -osirrox on -indev "$OUTPUT" \
        -extract /minios/metadata "$extracted" -end
    [ "$status" -eq 0 ]
    [ "$(stat -c '%a' "$extracted/executable")" = 755 ]
    [ "$(stat -c '%a' "$extracted/plain")" = 644 ]
    [ "$(stat -c '%a' "$extracted/large.bin")" = 644 ]
    [ -L "$extracted/plain-link" ]
    [ "$(stat -c '%a' "$extracted/plain-link")" = 777 ]
    [ "$(readlink "$extracted/plain-link")" = plain ]
    [ "$(stat -c '%Y' "$extracted/executable")" = 1700000000 ]
    [ "$(stat -c '%Y' "$extracted/plain")" = 1700000000 ]
}

@test "real xorriso preserves the MiniOS chainloader while transforming authoritative GRUB" {
    (( EUID != 0 )) || skip 'rootless chainloader integration requires an unprivileged caller'
    prepare_real_iso_fixture
    prepare_syslinux_grub_fixture
    kernel_text='audit=1 real_chainloader=verified'

    run env PATH="$REAL_XORRISO_TOOLS:$SYSTEM_PATH" TMPDIR="$TEMP_ROOT" \
        MINIOS_TOOLS_TEST_ALLOW_NON_ROOT=1 MINIOS_TOOLS_TEST_ROOT="$TEST_ROOT" \
        REAL_XORRISO="$REAL_XORRISO" REAL_XORRISO_STATE="$REAL_XORRISO_STATE" \
        LC_ALL=C.UTF-8 LANG=C.UTF-8 NO_COLOR=1 \
        "$COMPOSE" --source "$SOURCE" --config "$CONFIG" --name "$OUTPUT" \
        --boot-timeout 4 --default-boot fresh --kernel-args "$kernel_text"

    [ "$status" -eq 0 ]
    [ -s "$OUTPUT" ]
    extracted="$TEST_ROOT/real chainloader extraction"
    mkdir "$extracted"
    run "$REAL_XORRISO" -no_rc -osirrox on -indev "$OUTPUT" \
        -extract /minios/boot/grub/main.cfg "$extracted/main.cfg" \
        -extract /minios/boot/syslinux/syslinux.cfg "$extracted/syslinux.cfg" -end
    [ "$status" -eq 0 ]
    grep -Fqx 'set timeout=4' "$extracted/main.cfg"
    grep -Fqx 'set default=3' "$extracted/main.cfg"
    [ "$(grep -Fc " $kernel_text" "$extracted/main.cfg")" -eq 5 ]
    grep -Fqx 'TIMEOUT 1' "$extracted/syslinux.cfg"
    grep -Fqx 'LINUX /minios/boot/grub/i386-pc/lnxboot.img' "$extracted/syslinux.cfg"
    grep -Fqx 'INITRD /minios/boot/grub/i386-pc/core.img' "$extracted/syslinux.cfg"
    [ "$(grep -Fc "$kernel_text" "$extracted/syslinux.cfg")" -eq 0 ]
}

