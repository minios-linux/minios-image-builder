@test "overlay rejects escaping links special objects directory symlinks and exhausted order" {
    overlay="$TEST_ROOT/unsafe overlay"
    mkdir "$overlay"
    pushd "$TEST_ROOT" >/dev/null

    ln -s /etc/passwd "$overlay/absolute-link"
    run_compose --overlay-directory "$overlay"
    [ "$status" -ne 0 ]
    assert_output_contains 'could not be snapshotted safely'
    rm "$overlay/absolute-link"

    ln -s ../../outside "$overlay/escaping-link"
    run_compose --overlay-directory "$overlay"
    [ "$status" -ne 0 ]
    assert_output_contains 'could not be snapshotted safely'
    rm "$overlay/escaping-link"

    mkfifo "$overlay/unsafe-fifo"
    run_compose --overlay-directory "$overlay"
    [ "$status" -ne 0 ]
    assert_output_contains 'could not be snapshotted safely'
    rm "$overlay/unsafe-fifo"

    ln -s "$overlay" "$TEST_ROOT/overlay-link"
    run_compose --overlay-directory "$TEST_ROOT/overlay-link"
    [ "$status" -ne 0 ]
    assert_output_contains 'readable real directory'

    write_file "$SOURCE/999999-late.sb" late
    run_compose --overlay-directory "$overlay"
    [ "$status" -eq 3 ]
    assert_output_contains 'No safe numeric order remains'
    [ ! -e "$OUTPUT" ]
    popd >/dev/null
}

@test "overlay snapshot detects concurrent input mutation and removes private output" {
    overlay="$TEST_ROOT/mutating overlay"
    pause="$TEST_ROOT/overlay mutation pause"
    log="$TEST_ROOT/overlay-mutation.log"
    mkdir "$overlay"
    write_file "$overlay/value" before

    COMPOSE_TEST_OVERLAY_PAUSE="$pause" start_overlay_compose "$log" \
        --overlay-directory "$overlay"
    script_pid=$STARTED_COMPOSE_PID
    for _ in {1..500}; do
        [[ -e $pause.ready ]] && break
        sleep 0.02
    done
    [ -e "$pause.ready" ]
    write_file "$overlay/value" after
    : >"$pause.continue"
    set +e
    wait "$script_pid"
    result=$?
    set -e

    [ "$result" -ne 0 ]
    grep -q 'could not be snapshotted safely' "$log"
    [ ! -e "$OUTPUT" ]
    shopt -s nullglob dotglob
    leftovers=("$TEMP_ROOT"/*)
    [ "${#leftovers[@]}" -eq 0 ]
}

@test "overlay SquashFS must exactly represent its captured manifest" {
    overlay="$TEST_ROOT/manifest overlay"
    mkdir -p "$overlay/etc"
    write_file "$overlay/etc/value" trusted
    local mutation

    pushd "$TEST_ROOT" >/dev/null
    for mutation in extra:unexpected mutate:etc/value remove:etc/value; do
        UNSQUASHFS_TAMPER_TREE=$mutation run_compose --overlay-directory "$overlay"
        [ "$status" -ne 0 ]
        assert_output_contains 'does not match the captured input manifest'
        [ ! -e "$OUTPUT" ]
    done
    popd >/dev/null
}

@test "TERM stops stubborn overlay mksquashfs descendants and cleans the build" {
    overlay="$TEST_ROOT/cancel overlay"
    started="$TEST_ROOT/overlay-mksquashfs.started"
    log="$TEST_ROOT/overlay-cancel.log"
    mkdir "$overlay"
    write_file "$overlay/value" value

    MKSQUASHFS_SLEEP=true MKSQUASHFS_SLEEP_MARKER="$started" \
        MKSQUASHFS_STUBBORN=true start_overlay_compose "$log" \
        --overlay-directory "$overlay"
    script_pid=$STARTED_COMPOSE_PID
    for _ in {1..500}; do
        [[ -e $started ]] && break
        sleep 0.02
    done
    [ -e "$started" ]
    mapfile -t child_pids <"$started"
    [ "${#child_pids[@]}" -eq 2 ]
    kill -TERM "$script_pid"
    set +e
    wait "$script_pid"
    result=$?
    set -e

    [ "$result" -eq 130 ]
    grep -Fqx 'P:customize' "$log"
    for child_pid in "${child_pids[@]}"; do
        assert_process_gone "$child_pid"
    done
    [ ! -e "$OUTPUT" ]
    shopt -s nullglob dotglob
    leftovers=("$TEMP_ROOT"/*)
    [ "${#leftovers[@]}" -eq 0 ]
}

